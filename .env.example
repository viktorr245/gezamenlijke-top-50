# Alleen nodig buiten de vertrouwde lokale modus. Maak echte waarden met
# `npm run auth:generate`; deze opzettelijk ongeldige placeholders werken niet.
AUTH_SECRET=LAAT-DIT-NIET-STAAN-GENEREER-EEN-EIGEN-GEHEIM
MEMBER_PINS={"viktor":"VERVANG","daniel":"VERVANG","keano":"VERVANG","sander":"VERVANG","jurjan":"VERVANG"}
# Alleen achter een eigen reverse proxy die inkomende IP-headers overschrijft:
# TRUST_PROXY=true
# Publieke origin zonder pad, vereist wanneer publieke HTTPS intern als HTTP wordt geproxied:
# PUBLIC_ORIGIN=https://degezamenlijke50.boe.moe

# Permanente serveropslag en optionele grenzen.
STORAGE_DIR=/pad/naar/blijvende-opslag
STORAGE_QUOTA_GB=25
MIN_FREE_STORAGE_MB=512
BACKUP_DIR=/pad/naar/back-ups

# Alleen instellen als FFmpeg en FFprobe niet via PATH beschikbaar zijn.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
