---
import AppShell from "../components/AppShell.astro";
const discColors = ["#980f1d", "#174c3b", "#c18a16"];
---

<AppShell active="cds" title="De cd’s">
  <section class="discs-page" aria-labelledby="discs-title">
    <div class="discs-heading">
      <div>
        <p class="eyebrow" id="disc-eyebrow">Conceptindeling</p>
        <h1 id="discs-title">Vijftig nummers. Drie cd’s.</h1>
        <p class="heading-copy" id="disc-copy">Na de laatste stem verdelen we de top 50 automatisch.</p>
      </div>
      <div class="disc-summary" aria-label="Vijftig nummers verdeeld over drie schijfjes">
        <p><strong>50</strong><span>nummers</span></p>
        <p><strong>3</strong><span>schijfjes</span></p>
      </div>
    </div>

    <div class="disc-gate" id="disc-gate" role="status">
      <span class="search-loader" aria-hidden="true"></span>
      <h2>Cd-indeling laden…</h2>
    </div>

    <div id="disc-content" hidden>
      <div class="disc-tabs" role="group" aria-label="Kies een cd">
        {[0, 1, 2].map((index) => (
          <button type="button" data-disc-tab={index} aria-pressed={index === 0 ? "true" : "false"} style={`--disc-color:${discColors[index]}`}>
            CD {String(index + 1).padStart(2, "0")}
          </button>
        ))}
      </div>
      <div class="disc-grid" id="disc-grid">
        {[0, 1, 2].map((index) => (
          <section class:list={["disc-column", { active: index === 0 }]} data-disc={index} style={`--disc-color:${discColors[index]}`}>
            <header>
              <h2>CD {String(index + 1).padStart(2, "0")}</h2>
              <p class="disc-rank-range" data-disc-range>Plek —</p>
              <p class="disc-duration"><span data-disc-duration>0:00</span> / 80:00</p>
              <span class="capacity-track"><i></i></span>
            </header>
            <ol class="disc-track-list"></ol>
          </section>
        ))}
      </div>
      <section class="burn-packages" id="burn-packages" aria-labelledby="burn-packages-title" hidden>
        <div class="burn-packages-heading">
          <div>
            <p class="eyebrow">Klaar om te branden</p>
            <h2 id="burn-packages-title">Download je drie cd’s.</h2>
          </div>
          <p class="burn-package-format">WAV <span>44,1 kHz · 16-bit stereo</span></p>
        </div>
        <div class="burn-package-progress" id="burn-package-progress" role="status" aria-live="polite">
          <div><span id="burn-package-progress-bar"></span></div>
          <p id="burn-package-status">Brandpakketten voorbereiden…</p>
        </div>
        <div class="burn-package-downloads" id="burn-package-downloads" hidden></div>
        <div class="burn-package-error" id="burn-package-error" hidden>
          <p></p>
          <button class="text-action" id="retry-burn-packages" type="button">Opnieuw proberen</button>
        </div>
        <p class="burn-package-note">De bestands- en tracknummers lopen over de drie cd’s door van 01 tot 50. Iedere cd bevat WAV-bestanden, een M3U8-afspeellijst, een CUE-bestand, een tracklijst en brandinstructies.</p>
        <details class="burn-guide">
          <summary>Doorlopende tracknummers branden in Windows</summary>
          <p>Gebruik een brandprogramma waarin je het eerste tracknummer van een cd kunt instellen, zoals VEGAS Pro. Stel dit voor iedere cd in op het eerste nummer dat hierboven staat. Gewone brandprogramma’s kunnen de teller op iedere cd opnieuw bij 1 laten beginnen.</p>
        </details>
      </section>
      <div class="disc-footer">
        <button class="outlined-action" type="button" id="finalize-discs" hidden>Indeling definitief maken</button>
        <p id="disc-message" role="status" aria-live="polite"></p>
        <button class="text-action" type="button" id="retry-layout-save" hidden>Opnieuw opslaan</button>
      </div>
    </div>

    <details class="storage-card" id="storage-card" hidden>
      <summary>Serveropslag</summary>
      <dl>
        <div><dt>In gebruik</dt><dd id="storage-used">—</dd></div>
        <div><dt>Vrij beschikbaar</dt><dd id="storage-free">—</dd></div>
        <div><dt>Opslaglimiet</dt><dd id="storage-quota">—</dd></div>
        <div><dt>Laatste back-up gevonden</dt><dd id="storage-backup">—</dd></div>
      </dl>
      <p id="storage-warning" role="status" aria-live="polite"></p>
    </details>
  </section>
</AppShell>

<script>
  import { MAX_DISC_SECONDS, discDurationSeconds, distributeRankedTracks } from "../data/disc-distribution";
  import { formatDuration, type Track } from "../data/tracks";
  import { getActiveMember } from "../scripts/member-session";

  type DiscLayout = { discs: string[][]; topTrackIds: string[]; updatedAt: string; finalizedAt: string | null };
  type BurnPackageStatus = {
    state: "preparing" | "ready" | "error";
    completedTracks: number;
    totalTracks: number;
    currentDisc: number | null;
    currentTrack: string | null;
    error: string | null;
    downloads: Array<{ id: string; label: string; url: string; size: number }>;
  };
  type Payload = {
    status: { votingComplete: boolean; completedVoterCount: number };
    layout: DiscLayout | null;
    tracks: Track[];
    organizerId: string;
  };

  const memberId = getActiveMember();
  const gate = document.querySelector<HTMLElement>("#disc-gate")!;
  const content = document.querySelector<HTMLElement>("#disc-content")!;
  const grid = document.querySelector<HTMLElement>("#disc-grid")!;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-disc-tab]"));
  const message = document.querySelector<HTMLElement>("#disc-message")!;
  const copy = document.querySelector<HTMLElement>("#disc-copy")!;
  const eyebrow = document.querySelector<HTMLElement>("#disc-eyebrow")!;
  const finalizeButton = document.querySelector<HTMLButtonElement>("#finalize-discs")!;
  const retryLayoutSave = document.querySelector<HTMLButtonElement>("#retry-layout-save")!;
  const burnPackages = document.querySelector<HTMLElement>("#burn-packages")!;
  const burnProgress = document.querySelector<HTMLElement>("#burn-package-progress")!;
  const burnProgressBar = document.querySelector<HTMLElement>("#burn-package-progress-bar")!;
  const burnStatus = document.querySelector<HTMLElement>("#burn-package-status")!;
  const burnDownloads = document.querySelector<HTMLElement>("#burn-package-downloads")!;
  const burnError = document.querySelector<HTMLElement>("#burn-package-error")!;
  const retryBurnPackages = document.querySelector<HTMLButtonElement>("#retry-burn-packages")!;
  let tracks = new Map<string, Track>();
  let rankingPositions = new Map<string, number>();
  let discs: string[][] = [[], [], []];
  let organizerId = "viktor";
  let finalizedAt: string | null = null;
  let activeDisc = 0;
  let saveQueue = Promise.resolve();
  let saveError = "";
  let packagePoll: number | undefined;

  function escapeHtml(value: unknown): string {
    return String(value).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[character]!);
  }

  function duration(ids: string[]) {
    return discDurationSeconds(ids.map((id) => ({ duration: tracks.get(id)?.duration ?? 0 })));
  }

  function formatBytes(bytes: number) {
    if (bytes >= 1024 ** 3) return `${(bytes / 1024 ** 3).toLocaleString("nl-NL", { maximumFractionDigits: 1 })} GB`;
    return `${Math.max(1, Math.round(bytes / 1024 ** 2))} MB`;
  }

  async function loadStorageStatus() {
    if (memberId !== "viktor") return;
    const card = document.querySelector<HTMLDetailsElement>("#storage-card")!;
    card.hidden = false;
    try {
      const response = await fetch(`/api/storage-status?memberId=${encodeURIComponent(memberId)}`, { headers: { Accept: "application/json" } });
      const payload = await response.json() as { storage?: { usedBytes: number; availableBytes: number; quotaBytes: number | null; remainingBytes: number; minimumFreeBytes: number; lastBackupAt: string | null }; error?: string };
      if (!response.ok || !payload.storage) throw new Error(payload.error ?? "Opslagstatus niet beschikbaar.");
      const storage = payload.storage;
      document.querySelector<HTMLElement>("#storage-used")!.textContent = formatBytes(storage.usedBytes);
      document.querySelector<HTMLElement>("#storage-free")!.textContent = formatBytes(storage.availableBytes);
      document.querySelector<HTMLElement>("#storage-quota")!.textContent = storage.quotaBytes === null ? "niet ingesteld" : formatBytes(storage.quotaBytes);
      document.querySelector<HTMLElement>("#storage-backup")!.textContent = storage.lastBackupAt
        ? new Intl.DateTimeFormat("nl-NL", { dateStyle: "medium", timeStyle: "short" }).format(new Date(storage.lastBackupAt))
        : "geen back-up aangetroffen";
      document.querySelector<HTMLElement>("#storage-warning")!.textContent = storage.remainingBytes < storage.minimumFreeBytes
        ? "Let op: de vrije opslagruimte is onder de ingestelde veiligheidsmarge."
        : "";
    } catch (error) {
      document.querySelector<HTMLElement>("#storage-warning")!.textContent = error instanceof Error ? error.message : "Opslagstatus niet beschikbaar.";
    }
  }

  function renderBurnPackages(status: BurnPackageStatus) {
    burnPackages.hidden = false;
    burnProgress.hidden = status.state === "ready";
    burnDownloads.hidden = status.state !== "ready";
    burnError.hidden = status.state !== "error";
    const percentage = status.totalTracks ? status.completedTracks / status.totalTracks * 100 : 0;
    burnProgressBar.style.width = `${Math.max(2, Math.min(100, percentage))}%`;
    burnStatus.textContent = status.state === "preparing"
      ? status.currentTrack
        ? status.currentDisc
          ? `CD ${status.currentDisc}: ${status.currentTrack} · ${status.completedTracks} van ${status.totalTracks}`
          : status.currentTrack
        : "Originele audiobestanden controleren…"
      : "";
    if (status.state === "ready") {
      burnDownloads.innerHTML = status.downloads.map((download) => `
        <a class="burn-download ${download.id === "all" ? "burn-download--all" : ""}" href="${escapeHtml(download.url)}" download>
          <span>${escapeHtml(download.label)}</span>
          <small>${formatBytes(download.size)}</small>
          <i class="ph ph-download-simple" aria-hidden="true"></i>
        </a>`).join("");
    }
    burnError.querySelector("p")!.textContent = status.error ?? "De brandpakketten konden niet worden gemaakt.";
    retryBurnPackages.hidden = memberId !== organizerId;
  }

  async function loadBurnPackages(retry = false) {
    if (!finalizedAt) return;
    window.clearTimeout(packagePoll);
    try {
      const response = await fetch("/api/burn-packages", {
        method: retry ? "POST" : "GET",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: retry ? JSON.stringify({ memberId }) : undefined,
      });
      const result = await response.json() as { packages?: BurnPackageStatus; error?: string };
      if (!response.ok || !result.packages) throw new Error(result.error ?? "De brandpakketten konden niet worden geladen.");
      renderBurnPackages(result.packages);
      if (result.packages.state === "preparing") packagePoll = window.setTimeout(() => loadBurnPackages(), 1200);
    } catch (error) {
      renderBurnPackages({
        state: "error",
        completedTracks: 0,
        totalTracks: 50,
        currentDisc: null,
        currentTrack: null,
        error: error instanceof Error ? error.message : "De brandpakketten konden niet worden geladen.",
        downloads: [],
      });
    }
  }

  function editable() {
    return memberId === organizerId && !finalizedAt;
  }

  function rowMarkup(id: string) {
    const track = tracks.get(id);
    if (!track) return "";
    const rank = rankingPositions.get(id) ?? 0;
    return `
      <li class="disc-track" data-track-id="${escapeHtml(id)}" data-rank="${rank}">
        <img src="${escapeHtml(track.cover)}" alt="" width="56" height="56" />
        <span><strong>${String(rank).padStart(2, "0")} &nbsp; ${escapeHtml(track.title)}</strong><small>${escapeHtml(track.artist)}</small></span>
        <time>${formatDuration(track.duration)}</time>
      </li>`;
  }

  function render() {
    grid.querySelectorAll<HTMLElement>("[data-disc]").forEach((column, discIndex) => {
      const total = duration(discs[discIndex]);
      column.classList.toggle("active", discIndex === activeDisc);
      column.classList.toggle("over-capacity", total > MAX_DISC_SECONDS);
      column.querySelector<HTMLElement>("[data-disc-duration]")!.textContent = formatDuration(total);
      column.querySelector<HTMLElement>(".capacity-track i")!.style.width = `${Math.min(100, total / (MAX_DISC_SECONDS / 100))}%`;
      const firstRank = rankingPositions.get(discs[discIndex][0]);
      const lastRank = rankingPositions.get(discs[discIndex].at(-1)!);
      column.querySelector<HTMLElement>("[data-disc-range]")!.textContent = firstRank && lastRank
        ? `Plek ${String(firstRank).padStart(2, "0")}–${String(lastRank).padStart(2, "0")}`
        : "Geen nummers";
      column.querySelector<HTMLOListElement>(".disc-track-list")!.innerHTML = discs[discIndex].map(rowMarkup).join("");
    });
    tabs.forEach((tab, index) => tab.setAttribute("aria-pressed", String(index === activeDisc)));
    const over = discs.some((disc) => duration(disc) > MAX_DISC_SECONDS);
    finalizeButton.hidden = memberId !== organizerId || Boolean(finalizedAt);
    finalizeButton.disabled = !editable() || over || Boolean(saveError);
    finalizeButton.textContent = "Indeling definitief maken";
    eyebrow.textContent = finalizedAt ? "Definitieve indeling" : "Conceptindeling";
    copy.textContent = finalizedAt
      ? "De top 50 loopt in ranglijstvolgorde door van cd 1 naar cd 3 en staat nu vast."
      : editable()
        ? "De ranglijstvolgorde ligt vast. De twee beste knippunten zijn automatisch gekozen op basis van de echte audiolengtes."
        : "De ranglijstvolgorde ligt vast. Viktor kan deze automatische indeling definitief maken.";
    message.textContent = saveError || (over ? "Zelfs de best passende verdeling bevat een cd die langer is dan 80 minuten." : "");
    message.classList.toggle("error", Boolean(saveError) || over);
    retryLayoutSave.hidden = !saveError || !editable();
  }

  async function persist(snapshot: string[][]) {
    const response = await fetch("/api/disc-layout", {
      method: "PUT",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ memberId, discs: snapshot }),
    });
    const result = await response.json() as { layout?: DiscLayout; error?: string };
    if (!response.ok || !result.layout) throw new Error(result.error ?? "De indeling kon niet worden opgeslagen.");
    finalizedAt = result.layout.finalizedAt;
  }

  function queueSave() {
    const snapshot = discs.map((disc) => [...disc]);
    saveError = "";
    render();
    saveQueue = saveQueue.then(() => persist(snapshot)).then(() => { saveError = ""; }).catch((error) => {
      saveError = error instanceof Error ? error.message : "De indeling kon niet worden opgeslagen.";
    }).finally(render);
  }

  tabs.forEach((tab, index) => tab.addEventListener("click", () => { activeDisc = index; render(); }));
  finalizeButton.addEventListener("click", async () => {
    if (!editable() || discs.some((disc) => duration(disc) > MAX_DISC_SECONDS)) return;
    if (!window.confirm("De server controleert de echte audiolengtes en zet de ranglijstvolgorde en cd-grenzen definitief vast. Hierna worden de drie brandpakketten gemaakt. Doorgaan?")) return;
    finalizeButton.disabled = true;
    await saveQueue;
    if (saveError) {
      render();
      return;
    }
    try {
      const response = await fetch("/api/disc-layout", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ memberId }),
      });
      const result = await response.json() as { layout?: DiscLayout; error?: string };
      if (!response.ok || !result.layout) throw new Error(result.error ?? "Definitief maken mislukt.");
      finalizedAt = result.layout.finalizedAt;
      saveError = "";
      void loadBurnPackages();
    } catch (error) {
      saveError = error instanceof Error ? error.message : "Definitief maken mislukt.";
    }
    render();
  });
  retryLayoutSave.addEventListener("click", queueSave);
  retryBurnPackages.addEventListener("click", () => void loadBurnPackages(true));
  void loadStorageStatus();

  fetch("/api/disc-layout", { headers: { Accept: "application/json" } })
    .then(async (response) => {
      const payload = await response.json() as Payload & { error?: string };
      if (!response.ok) throw new Error(payload.error ?? "De cd-indeling kon niet worden geladen.");
      organizerId = payload.organizerId;
      if (!payload.status.votingComplete) {
        gate.innerHTML = `<p class="eyebrow">Nog niet beschikbaar</p><h2>De top 50 staat nog niet vast.</h2><p>${payload.status.completedVoterCount} van 5 deelnemers zijn klaar met stemmen.</p>`;
        return;
      }
      tracks = new Map(payload.tracks.map((track) => [track.id, track]));
      rankingPositions = new Map(payload.tracks.map((track, index) => [track.id, index + 1]));
      discs = payload.layout?.discs.map((disc) => [...disc]) ?? distributeRankedTracks(payload.tracks);
      finalizedAt = payload.layout?.finalizedAt ?? null;
      gate.hidden = true;
      content.hidden = false;
      render();
      if (!payload.layout && editable()) queueSave();
      if (finalizedAt) void loadBurnPackages();
    })
    .catch((error) => {
      gate.innerHTML = `<p class="eyebrow">Niet beschikbaar</p><h2>De cd-indeling kan niet worden geladen.</h2><p>${escapeHtml(error instanceof Error ? error.message : "Probeer het later opnieuw.")}</p>`;
    });
</script>
