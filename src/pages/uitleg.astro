---
import AppShell from "../components/AppShell.astro";
---

<AppShell active="uitleg" title="Zo werkt de ranglijst">
  <article class="learn-page">
    <header class="learn-hero">
      <div class="learn-hero-copy">
        <p class="eyebrow">Interactieve uitleg</p>
        <h1>Van één keuze naar de top 50.</h1>
        <p>Je hoeft niets van statistiek te weten. Maak zelf een paar keuzes en zie stap voor stap wat de website ermee doet.</p>
        <div class="learn-hero-actions">
          <a class="outlined-action" href="#keuzes">Begin bij de eerste keuze</a>
          <span><i class="ph ph-clock" aria-hidden="true"></i> Ongeveer 8 minuten</span>
        </div>
      </div>
      <ol class="learn-route" aria-label="Het hele rekenproces">
        <li><span>01</span><strong>Jullie kiezen</strong><small>600 directe vergelijkingen</small></li>
        <li><span>02</span><strong>Het model schat</strong><small>100 onderliggende sterktes</small></li>
        <li><span>03</span><strong>De server simuleert</strong><small>100.000 mogelijke ranglijsten</small></li>
        <li><span>04</span><strong>De grens beslist</strong><small>50 nummers gaan naar de cd’s</small></li>
      </ol>
    </header>

    <nav class="learn-progress" aria-label="Hoofdstukken">
      <span><strong id="learn-progress-current">1</strong> / 6</span>
      <div aria-hidden="true"><i id="learn-progress-bar"></i></div>
      <div>
        <a href="#keuzes" data-lesson-link class="active">Kiezen</a>
        <a href="#kans" data-lesson-link>Kans</a>
        <a href="#onzekerheid" data-lesson-link>Onzekerheid</a>
        <a href="#simulaties" data-lesson-link>Simulaties</a>
        <a href="#cijfers" data-lesson-link>Cijfers</a>
        <a href="#beslissing" data-lesson-link>Beslissing</a>
      </div>
    </nav>

    <section class="learn-chapter" id="keuzes" data-lesson-section>
      <header class="learn-chapter-heading">
        <span>01</span>
        <div>
          <p class="eyebrow">De ruwe informatie</p>
          <h2>Een keuze is nog geen punt.</h2>
          <p>De server bewaart alleen welk nummer won van welk ander nummer. Maak de zes duels in dit kleine voorbeeld; de sterktes rechts bewegen na iedere keuze mee.</p>
        </div>
      </header>

      <div class="learn-model-demo">
        <div class="learn-mini-vote">
          <div class="learn-demo-counter"><strong id="demo-choice-count">0</strong><span>van 6 keuzes</span></div>
          <div class="learn-demo-marks" id="demo-choice-marks" aria-hidden="true">
            {Array.from({ length: 6 }, () => <i></i>)}
          </div>
          <div class="learn-demo-pair" id="demo-pair"></div>
          <p class="learn-demo-status" id="demo-status" aria-live="polite">Kies puur op gevoel. Er is geen fout antwoord.</p>
        </div>

        <aside class="learn-strength-live" aria-labelledby="strength-live-title">
          <div>
            <p class="eyebrow">Live model</p>
            <h3 id="strength-live-title">Geschatte sterktes</h3>
            <button class="text-action" id="reset-demo" type="button">Opnieuw</button>
          </div>
          <div class="learn-strength-list" id="demo-strengths"></div>
          <p><strong>Wat beweegt hier?</strong> Het model zoekt na iedere keuze de vier sterktes die alle keuzes samen het best verklaren. In het echte proces gebeurt dit met 100 nummers en pas nadat iedereen klaar is.</p>
        </aside>
      </div>

      <div class="learn-takeaway">
        <span>Onthoud</span>
        <p>Een overwinning is niet simpelweg één punt. Winnen van een nummer dat zelf sterke tegenstanders versloeg, werkt via het hele netwerk door.</p>
      </div>
      <a class="learn-next" href="#kans">Volgende: wat betekent sterkte? <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </section>

    <section class="learn-chapter" id="kans" data-lesson-section>
      <header class="learn-chapter-heading">
        <span>02</span>
        <div>
          <p class="eyebrow">Bradley–Terry zonder jargon</p>
          <h2>Sterkte is een verschil, geen rapportcijfer.</h2>
          <p>Alleen het verschil tussen twee sterktes bepaalt de geschatte kans dat iemand het ene nummer boven het andere kiest.</p>
        </div>
      </header>

      <div class="learn-probability-demo">
        <div class="probability-labels">
          <div><img src="/covers/smooth-operator.webp" alt="" /><span><strong>Smooth Operator</strong><small>Sterkte A</small></span></div>
          <div><span><strong>Nightcall</strong><small>Sterkte B</small></span><img src="/covers/nightcall.webp" alt="" /></div>
        </div>
        <div class="probability-bar" aria-label="Geschatte voorkeur">
          <span id="probability-a">73%</span><span id="probability-b">27%</span>
        </div>
        <label for="strength-difference">Verschil tussen A en B: <strong id="strength-difference-value">+1,00</strong></label>
        <input id="strength-difference" type="range" min="-2" max="2" value="1" step="0.05" />
        <div class="probability-scale"><span>B is sterker</span><span>Even sterk</span><span>A is sterker</span></div>
        <div class="probability-formula">
          <span>P(A gekozen)</span>
          <strong>1 / (1 + e<sup>−verschil</sup>)</strong>
          <output id="probability-sentence">Bij één punt verschil wordt A naar schatting in 73% van zulke duels gekozen.</output>
        </div>
      </div>

      <div class="learn-facts">
        <article><strong>0 punten verschil</strong><span>50% tegenover 50%</span></article>
        <article><strong>1 punt verschil</strong><span>ongeveer 73% tegenover 27%</span></article>
        <article><strong>2 punten verschil</strong><span>ongeveer 88% tegenover 12%</span></article>
      </div>
      <a class="learn-next" href="#onzekerheid">Volgende: wanneer weet het model genoeg? <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </section>

    <section class="learn-chapter" id="onzekerheid" data-lesson-section>
      <header class="learn-chapter-heading">
        <span>03</span>
        <div>
          <p class="eyebrow">Niet doen alsof we alles zeker weten</p>
          <h2>Eén beste sterkte is niet het hele verhaal.</h2>
          <p>Rond iedere geschatte sterkte liggen andere waarden die óók redelijk bij de keuzes passen. Hoe meer informatieve verbindingen, hoe smaller dat gebied meestal wordt.</p>
        </div>
      </header>

      <div class="learn-uncertainty-demo">
        <div class="uncertainty-control">
          <label for="evidence-count">Aantal informatieve duels <strong id="evidence-value">4</strong></label>
          <input id="evidence-count" type="range" min="2" max="12" value="4" step="1" />
          <div><span>weinig informatie</span><span>volledig schema</span></div>
        </div>
        <div class="uncertainty-plot" aria-label="Mogelijke sterktes rond de beste schatting">
          <span class="uncertainty-zero" aria-hidden="true"></span>
          <span class="uncertainty-best" aria-hidden="true"><i></i><small>beste schatting +0,15</small></span>
          <div id="uncertainty-dots" aria-hidden="true"></div>
          <div class="uncertainty-axis"><span>−2</span><span>−1</span><span>0</span><span>+1</span><span>+2</span></div>
        </div>
        <p class="uncertainty-result">In dit vereenvoudigde voorbeeld ligt het middelste gebied ongeveer tussen <strong id="uncertainty-range">−0,95 en +1,25</strong>.</p>
      </div>

      <button class="learn-question" id="split-question" type="button" aria-expanded="false">
        <span>Snelle check</span>
        <strong>Betekent zes keer winnen en zes keer verliezen automatisch “heel onzeker”?</strong>
        <i class="ph ph-plus" aria-hidden="true"></i>
      </button>
      <div class="learn-answer" id="split-answer" hidden>
        <strong>Nee.</strong> Zes overwinningen tegen sterke nummers en zes nederlagen tegen nog sterkere nummers kunnen de sterkte juist scherp plaatsen. Tegenstanders en het volledige netwerk zijn belangrijker dan alleen 6–6.
      </div>
      <div class="learn-takeaway">
        <span>Op de ranglijst</span>
        <p>Een smal <strong>90%-bereik</strong> betekent dat de mogelijke posities dicht bij elkaar lagen. Een top-50-kans rond 50% kan daarnaast simpelweg betekenen dat een nummer precies bij de grens ligt.</p>
      </div>
      <a class="learn-next" href="#simulaties">Volgende: maak een mogelijke ranglijst <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </section>

    <section class="learn-chapter" id="simulaties" data-lesson-section>
      <header class="learn-chapter-heading">
        <span>04</span>
        <div>
          <p class="eyebrow">Van onzekerheid naar ranglijsten</p>
          <h2>Iedere trekking is één plausibele werkelijkheid.</h2>
          <p>De stemmen blijven hetzelfde. De server trekt alleen telkens een gezamenlijke set mogelijke sterktes en sorteert die. Deze mini-simulator gebruikt vier nummers en een top 2; echt zijn het 100 nummers en een top 50.</p>
        </div>
      </header>

      <div class="learn-simulator">
        <div class="simulation-stage">
          <header>
            <div><p class="eyebrow">Huidige trekking</p><h3>Mogelijke ranglijst</h3></div>
            <span id="simulation-number">Nog niet getrokken</span>
          </header>
          <ol id="simulation-ranking" aria-live="polite"></ol>
          <div class="simulation-actions">
            <button class="outlined-action" id="draw-one" type="button">Trek er één</button>
            <button class="outlined-action filled" id="run-simulations" type="button">Bereken 100.000</button>
          </div>
          <div class="simulation-progress" aria-live="polite">
            <div><i id="simulation-progress-bar"></i></div>
            <span id="simulation-progress-text">Probeer eerst één mogelijke ranglijst.</span>
          </div>
        </div>

        <div class="simulation-results">
          <header><p class="eyebrow">Wat we bijhouden</p><h3>Resultaten per nummer</h3></header>
          <div class="simulation-table-wrap">
            <table>
              <thead><tr><th>Nummer</th><th>Top 2</th><th>Verwacht</th><th>90%-bereik</th></tr></thead>
              <tbody id="simulation-metrics"></tbody>
            </table>
          </div>
          <p><strong>Belangrijk:</strong> in het echte model worden de sterktes samen getrokken. Hun onderlinge afhankelijkheid uit gedeelde tegenstanders blijft daardoor behouden.</p>
        </div>
      </div>
      <a class="learn-next" href="#cijfers">Volgende: lees de drie uitkomsten <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </section>

    <section class="learn-chapter" id="cijfers" data-lesson-section>
      <header class="learn-chapter-heading">
        <span>05</span>
        <div>
          <p class="eyebrow">Tellen, middelen en grenzen zoeken</p>
          <h2>Drie cijfers, drie verschillende vragen.</h2>
          <p>Controleer of je het verschil ziet. Je mag zo vaak antwoorden als je wilt.</p>
        </div>
      </header>

      <form class="learn-quiz" id="learn-quiz">
        <fieldset data-answer="b">
          <legend><span>01</span>Een nummer stond 52.630 van de 100.000 keer in de top 50. Wat is de kans top 50?</legend>
          <label><input type="radio" name="question-1" value="a" /> 47,37%</label>
          <label><input type="radio" name="question-1" value="b" /> 52,63%</label>
          <label><input type="radio" name="question-1" value="c" /> Plek 52,63</label>
          <p class="quiz-explanation">52.630 ÷ 100.000 = 0,5263, dus 52,63%.</p>
        </fieldset>
        <fieldset data-answer="a">
          <legend><span>02</span>Alle 100.000 posities tellen samen op tot 4.940.000. Wat is de verwachte plek?</legend>
          <label><input type="radio" name="question-2" value="a" /> 49,4</label>
          <label><input type="radio" name="question-2" value="b" /> 50,6</label>
          <label><input type="radio" name="question-2" value="c" /> 4,94%</label>
          <p class="quiz-explanation">4.940.000 ÷ 100.000 = gemiddeld plek 49,4.</p>
        </fieldset>
        <fieldset data-answer="c">
          <legend><span>03</span>Het 90%-bereik is plek 37–62. Wat betekent dat?</legend>
          <label><input type="radio" name="question-3" value="a" /> Het nummer eindigt zeker op plek 49 of 50.</label>
          <label><input type="radio" name="question-3" value="b" /> Het won 37 keer en verloor 62 keer.</label>
          <label><input type="radio" name="question-3" value="c" /> In 90% van de simulaties lag de plek tussen 37 en 62.</label>
          <p class="quiz-explanation">Na sorteren van alle posities worden de onderste en bovenste 5% weggelaten. Het middelste 90%-gebied blijft over.</p>
        </fieldset>
        <div class="quiz-footer">
          <button class="outlined-action" type="submit">Controleer mijn antwoorden</button>
          <output id="quiz-result" aria-live="polite"></output>
        </div>
      </form>
      <a class="learn-next" href="#beslissing">Volgende: waarom juist deze top 50? <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
    </section>

    <section class="learn-chapter" id="beslissing" data-lesson-section>
      <header class="learn-chapter-heading">
        <span>06</span>
        <div>
          <p class="eyebrow">De definitieve beslissing</p>
          <h2>De ranglijst volgt het doel: de juiste vijftig kiezen.</h2>
          <p>Een sterkte is de beste enkele schatting. De top-50-kans voegt toe hoeveel onzekerheid er rond de selectiegrens zit.</p>
        </div>
      </header>

      <div class="decision-grid">
        <article>
          <span class="decision-number">1</span>
          <div><h3>Kans top 50</h3><p>Hoe vaak stond het nummer bij de vijftig geselecteerden? Dit bepaalt als eerste de volgorde.</p></div>
        </article>
        <article>
          <span class="decision-number">2</span>
          <div><h3>Verwachte plek</h3><p>Bij exact dezelfde top-50-kans komt de laagste gemiddelde positie eerst.</p></div>
        </article>
        <article>
          <span class="decision-number">3</span>
          <div><h3>Sterkte</h3><p>Is ook de verwachte plek gelijk, dan beslist de hoogste Bradley–Terry-sterkte.</p></div>
        </article>
        <article>
          <span class="decision-number">4</span>
          <div><h3>Vaste id</h3><p>Een technische laatste tiebreaker maakt dezelfde invoer altijd volledig reproduceerbaar.</p></div>
        </article>
      </div>

      <div class="learn-final-summary">
        <div>
          <p class="eyebrow">Je kent nu de hele route</p>
          <h2>Keuze → sterkte → mogelijke ranglijsten → top 50.</h2>
          <p>Iedere track krijgt twaalf duels, drie van elk van de vier andere deelnemers. Na alle 600 keuzes schat het model honderd sterktes. Vervolgens leveren 100.000 gezamenlijke trekkingen de top-50-kans, verwachte plek en het 90%-bereik.</p>
          <a class="outlined-action" href="/ranglijst">Naar de ranglijst</a>
        </div>
        <dl>
          <div><dt>Per nummer</dt><dd>12 duels</dd></div>
          <div><dt>Per deelnemer</dt><dd>120 keuzes</dd></div>
          <div><dt>Samen</dt><dd>600 keuzes</dd></div>
          <div><dt>Mogelijke lijsten</dt><dd>100.000</dd></div>
        </dl>
      </div>

      <details class="learn-technical">
        <summary>Ik wil nu wél de precieze wiskunde zien</summary>
        <div>
          <article><span>01</span><div><h3>Waarschijnlijkheid</h3><p>Voor ieder gekozen nummer A boven B gebruikt het model <strong>P(A) = 1 / (1 + e<sup>sterkte B − sterkte A</sup>)</strong>.</p></div></article>
          <article><span>02</span><div><h3>Beste sterktes</h3><p>Alle 600 log-waarschijnlijkheden worden gecombineerd met de zwakke prior <strong>θ ~ N(0, 4)</strong>. Newton-stappen vinden de best passende honderd sterktes.</p></div></article>
          <article><span>03</span><div><h3>Mogelijke sterktes</h3><p>De inverse Hessiaan beschrijft de lokale gezamenlijke onzekerheid. De Laplace-benadering is <strong>θ ~ N(θ̂, H<sup>−1</sup>)</strong>; Cholesky-ontbinding levert samenhangende trekkingen.</p></div></article>
          <article><span>04</span><div><h3>Verwachte plek</h3><p>Voor nummer i is dat <strong>E[Rᵢ] ≈ (Rᵢ¹ + … + Rᵢ¹⁰⁰⁰⁰⁰) / 100.000</strong>. De top-50-kans is het aandeel trekkingen waarin Rᵢ ≤ 50.</p></div></article>
        </div>
      </details>
    </section>
  </article>
</AppShell>

<script>
  type DemoTrack = { title: string; artist: string; cover: string };
  type DemoChoice = { winner: number; loser: number };

  const demoTracks: DemoTrack[] = [
    { title: "Smooth Operator", artist: "Sade", cover: "/covers/smooth-operator.webp" },
    { title: "Nightcall", artist: "Kavinsky", cover: "/covers/nightcall.webp" },
    { title: "Teardrop", artist: "Massive Attack", cover: "/covers/teardrop.webp" },
    { title: "Dreams", artist: "Fleetwood Mac", cover: "/covers/dreams.webp" },
  ];
  const demoPairs = [[0, 1], [2, 3], [0, 2], [1, 3], [0, 3], [1, 2]] as const;
  let demoChoices: DemoChoice[] = [];

  const demoPair = document.querySelector<HTMLElement>("#demo-pair")!;
  const demoStatus = document.querySelector<HTMLElement>("#demo-status")!;
  const demoCount = document.querySelector<HTMLElement>("#demo-choice-count")!;
  const demoStrengths = document.querySelector<HTMLElement>("#demo-strengths")!;
  const demoMarks = [...document.querySelectorAll<HTMLElement>("#demo-choice-marks i")];

  function sigmoid(value: number): number {
    return value >= 0 ? 1 / (1 + Math.exp(-value)) : Math.exp(value) / (1 + Math.exp(value));
  }

  function solve(matrixValue: number[][], vectorValue: number[]): number[] {
    const matrix = matrixValue.map((row) => [...row]);
    const vector = [...vectorValue];
    for (let column = 0; column < vector.length; column += 1) {
      let pivot = column;
      for (let row = column + 1; row < vector.length; row += 1) {
        if (Math.abs(matrix[row][column]) > Math.abs(matrix[pivot][column])) pivot = row;
      }
      [matrix[column], matrix[pivot]] = [matrix[pivot], matrix[column]];
      [vector[column], vector[pivot]] = [vector[pivot], vector[column]];
      const divisor = matrix[column][column];
      for (let item = column; item < vector.length; item += 1) matrix[column][item] /= divisor;
      vector[column] /= divisor;
      for (let row = 0; row < vector.length; row += 1) {
        if (row === column) continue;
        const factor = matrix[row][column];
        for (let item = column; item < vector.length; item += 1) matrix[row][item] -= factor * matrix[column][item];
        vector[row] -= factor * vector[column];
      }
    }
    return vector;
  }

  function fitDemoStrengths(): number[] {
    const precision = 0.25;
    const strengths = demoTracks.map(() => 0);
    for (let iteration = 0; iteration < 30; iteration += 1) {
      const gradient = strengths.map((value) => precision * value);
      const hessian = strengths.map((_, row) => strengths.map((__, column) => row === column ? precision : 0));
      for (const choice of demoChoices) {
        const probability = sigmoid(strengths[choice.winner] - strengths[choice.loser]);
        const weight = Math.max(probability * (1 - probability), 1e-7);
        gradient[choice.winner] += probability - 1;
        gradient[choice.loser] -= probability - 1;
        hessian[choice.winner][choice.winner] += weight;
        hessian[choice.loser][choice.loser] += weight;
        hessian[choice.winner][choice.loser] -= weight;
        hessian[choice.loser][choice.winner] -= weight;
      }
      const step = solve(hessian, gradient);
      strengths.forEach((_, index) => strengths[index] -= step[index]);
      if (Math.max(...step.map(Math.abs)) < 1e-8) break;
    }
    return strengths;
  }

  function signed(value: number, digits = 2): string {
    return `${value >= 0 ? "+" : ""}${value.toFixed(digits).replace(".", ",")}`;
  }

  function choiceMarkup(track: DemoTrack, side: "left" | "right"): string {
    return `<button class="learn-choice" type="button" data-demo-choice="${side}">
      <img src="${track.cover}" alt="" />
      <span><small>Kies deze</small><strong>${track.title}</strong><em>${track.artist}</em></span>
    </button>`;
  }

  function renderDemo(lastWinner?: number) {
    const strengths = fitDemoStrengths();
    demoCount.textContent = String(demoChoices.length);
    demoMarks.forEach((mark, index) => mark.classList.toggle("complete", index < demoChoices.length));
    demoStrengths.innerHTML = strengths
      .map((value, index) => {
        const position = Math.max(4, Math.min(96, ((value + 1.6) / 3.2) * 100));
        return `<div><span><img src="${demoTracks[index].cover}" alt="" /><strong>${demoTracks[index].title}</strong></span><span class="strength-axis"><i style="left:${position}%"></i></span><output>${signed(value)}</output></div>`;
      })
      .join("");
    if (demoChoices.length === demoPairs.length) {
      const order = strengths.map((value, index) => ({ value, index })).sort((a, b) => b.value - a.value);
      demoPair.innerHTML = `<div class="learn-demo-complete"><i class="ph ph-check" aria-hidden="true"></i><p class="eyebrow">Mini-model klaar</p><h3>${demoTracks[order[0].index].title} eindigt bovenaan.</h3><p>Niet door losse punten op te tellen, maar doordat deze vier sterktes alle zes keuzes gezamenlijk het best verklaren.</p></div>`;
      demoStatus.textContent = "Gebruik ‘Opnieuw’ om andere keuzes te proberen.";
      return;
    }
    const [left, right] = demoPairs[demoChoices.length];
    demoPair.innerHTML = `${choiceMarkup(demoTracks[left], "left")}<span class="learn-or">of</span>${choiceMarkup(demoTracks[right], "right")}`;
    demoStatus.textContent = lastWinner === undefined
      ? "Kies puur op gevoel. Er is geen fout antwoord."
      : `Je koos ${demoTracks[lastWinner].title}. Ook de sterktes van de andere nummers zijn opnieuw berekend.`;
  }

  demoPair.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-demo-choice]");
    if (!button || demoChoices.length >= demoPairs.length) return;
    const pair = demoPairs[demoChoices.length];
    const winner = button.dataset.demoChoice === "left" ? pair[0] : pair[1];
    const loser = winner === pair[0] ? pair[1] : pair[0];
    demoChoices.push({ winner, loser });
    renderDemo(winner);
  });
  document.querySelector("#reset-demo")?.addEventListener("click", () => {
    demoChoices = [];
    renderDemo();
  });
  renderDemo();

  const differenceInput = document.querySelector<HTMLInputElement>("#strength-difference")!;
  const probabilityBar = document.querySelector<HTMLElement>(".probability-bar")!;
  function renderProbability() {
    const difference = Number(differenceInput.value);
    const probability = sigmoid(difference);
    const left = probability * 100;
    probabilityBar.style.setProperty("--left-chance", `${left}%`);
    document.querySelector<HTMLElement>("#probability-a")!.textContent = `${Math.round(left)}%`;
    document.querySelector<HTMLElement>("#probability-b")!.textContent = `${Math.round(100 - left)}%`;
    document.querySelector<HTMLElement>("#strength-difference-value")!.textContent = signed(difference);
    const favoured = Math.abs(difference) < 0.005 ? "Beide nummers worden even vaak verwacht." : `${difference > 0 ? "A" : "B"} wordt naar schatting in ${Math.round(Math.max(probability, 1 - probability) * 100)}% van zulke duels gekozen.`;
    document.querySelector<HTMLOutputElement>("#probability-sentence")!.textContent = favoured;
  }
  differenceInput.addEventListener("input", renderProbability);
  renderProbability();

  const evidenceInput = document.querySelector<HTMLInputElement>("#evidence-count")!;
  const uncertaintyDots = document.querySelector<HTMLElement>("#uncertainty-dots")!;
  const illustrativeZ = [-2.05, -1.72, -1.5, -1.32, -1.18, -1.06, -0.94, -0.82, -0.7, -0.59, -0.48, -0.37, -0.27, -0.17, -0.08, 0, 0.08, 0.17, 0.27, 0.37, 0.48, 0.59, 0.7, 0.82, 0.94, 1.06, 1.18, 1.32, 1.5, 1.72, 2.05];
  function plotPosition(value: number): number {
    return Math.max(1, Math.min(99, ((value + 2) / 4) * 100));
  }
  function renderUncertainty() {
    const evidence = Number(evidenceInput.value);
    const mean = 0.15;
    const deviation = 0.76 / Math.sqrt(evidence / 2);
    document.querySelector<HTMLElement>("#evidence-value")!.textContent = String(evidence);
    uncertaintyDots.innerHTML = illustrativeZ.map((z, index) => `<i style="left:${plotPosition(mean + z * deviation)}%;bottom:${18 + index % 5 * 10}px"></i>`).join("");
    const low = mean - 1.645 * deviation;
    const high = mean + 1.645 * deviation;
    document.querySelector<HTMLElement>("#uncertainty-range")!.textContent = `${signed(low)} en ${signed(high)}`;
  }
  evidenceInput.addEventListener("input", renderUncertainty);
  renderUncertainty();

  const splitQuestion = document.querySelector<HTMLButtonElement>("#split-question")!;
  const splitAnswer = document.querySelector<HTMLElement>("#split-answer")!;
  splitQuestion.addEventListener("click", () => {
    const open = splitAnswer.hidden === true;
    splitAnswer.hidden = !open;
    splitQuestion.setAttribute("aria-expanded", String(open));
    splitQuestion.querySelector("i")?.classList.toggle("ph-plus", !open);
    splitQuestion.querySelector("i")?.classList.toggle("ph-minus", open);
  });

  const simulationTracks = [
    { title: "Smooth Operator", cover: "/covers/smooth-operator.webp", mean: 0.62 },
    { title: "Nightcall", cover: "/covers/nightcall.webp", mean: 0.30 },
    { title: "Teardrop", cover: "/covers/teardrop.webp", mean: 0.22 },
    { title: "Dreams", cover: "/covers/dreams.webp", mean: -0.05 },
  ];
  type SimulationStats = { total: number; top: number[]; rankSum: number[]; rankCounts: number[][] };
  let simulationStats: SimulationStats;
  let displayedSimulation = 0;
  let manualNormal = normalGenerator(739391);
  const drawOne = document.querySelector<HTMLButtonElement>("#draw-one")!;
  const runSimulations = document.querySelector<HTMLButtonElement>("#run-simulations")!;

  function resetSimulationStats(): SimulationStats {
    return { total: 0, top: [0, 0, 0, 0], rankSum: [0, 0, 0, 0], rankCounts: simulationTracks.map(() => [0, 0, 0, 0]) };
  }

  function seededRandom(seed: number): () => number {
    let state = seed | 0;
    return () => {
      state = state + 0x6d2b79f5 | 0;
      let value = Math.imul(state ^ state >>> 15, 1 | state);
      value = value + Math.imul(value ^ value >>> 7, 61 | value) ^ value;
      return Math.max(((value ^ value >>> 14) >>> 0) / 4294967296, Number.EPSILON);
    };
  }

  function normalGenerator(seed: number): () => number {
    const random = seededRandom(seed);
    let spare: number | undefined;
    return () => {
      if (spare !== undefined) {
        const value = spare;
        spare = undefined;
        return value;
      }
      const radius = Math.sqrt(-2 * Math.log(random()));
      const angle = 2 * Math.PI * random();
      spare = radius * Math.sin(angle);
      return radius * Math.cos(angle);
    };
  }

  function possibleStrengths(normal: () => number): number[] {
    const z = [normal(), normal(), normal(), normal()];
    const noise = [
      0.18 * z[0],
      0.08 * z[0] + 0.31 * z[1],
      0.05 * z[0] + 0.10 * z[1] + 0.25 * z[2],
      0.03 * z[0] - 0.02 * z[1] + 0.06 * z[2] + 0.22 * z[3],
    ];
    return simulationTracks.map((track, index) => track.mean + noise[index]);
  }

  function addSimulation(strengths: number[]) {
    const order = strengths.map((value, index) => ({ value, index })).sort((a, b) => b.value - a.value || a.index - b.index);
    simulationStats.total += 1;
    order.forEach((item, rank) => {
      simulationStats.rankSum[item.index] += rank + 1;
      simulationStats.rankCounts[item.index][rank] += 1;
      if (rank < 2) simulationStats.top[item.index] += 1;
    });
    return order;
  }

  function percentile(counts: number[], fraction: number): number {
    const target = Math.floor(Math.max(0, simulationStats.total - 1) * fraction);
    let cumulative = 0;
    for (let index = 0; index < counts.length; index += 1) {
      cumulative += counts[index];
      if (cumulative > target) return index + 1;
    }
    return counts.length;
  }

  function renderSimulationRanking(strengths: number[], order: Array<{ value: number; index: number }>) {
    document.querySelector<HTMLOListElement>("#simulation-ranking")!.innerHTML = order.map((item, rank) => {
      const track = simulationTracks[item.index];
      return `<li class="${rank < 2 ? "selected" : ""}"><span>${rank + 1}</span><img src="${track.cover}" alt="" /><div><strong>${track.title}</strong><small>centrale sterkte ${signed(track.mean)}</small></div><output>${signed(strengths[item.index])}</output></li>`;
    }).join("");
  }

  function renderSimulationMetrics() {
    document.querySelector<HTMLTableSectionElement>("#simulation-metrics")!.innerHTML = simulationTracks.map((track, index) => {
      const top = simulationStats.total ? `${(simulationStats.top[index] / simulationStats.total * 100).toFixed(simulationStats.total < 100 ? 0 : 1).replace(".", ",")}%` : "—";
      const expected = simulationStats.total ? (simulationStats.rankSum[index] / simulationStats.total).toFixed(2).replace(".", ",") : "—";
      const range = simulationStats.total > 1 ? `${percentile(simulationStats.rankCounts[index], 0.05)}–${percentile(simulationStats.rankCounts[index], 0.95)}` : "—";
      return `<tr><th><img src="${track.cover}" alt="" /><span>${track.title}</span></th><td>${top}</td><td>${expected}</td><td>${range}</td></tr>`;
    }).join("");
  }

  function drawManualSimulation() {
    const strengths = possibleStrengths(manualNormal);
    const order = addSimulation(strengths);
    displayedSimulation += 1;
    renderSimulationRanking(strengths, order);
    renderSimulationMetrics();
    document.querySelector<HTMLElement>("#simulation-number")!.textContent = `Trekking ${displayedSimulation}`;
    document.querySelector<HTMLElement>("#simulation-progress-text")!.textContent = `${simulationStats.total} mogelijke ${simulationStats.total === 1 ? "ranglijst" : "ranglijsten"} bekeken.`;
    document.querySelector<HTMLElement>("#simulation-progress-bar")!.style.width = `${Math.min(100, simulationStats.total)}%`;
  }

  async function calculateAllSimulations() {
    const total = 100_000;
    const batchSize = 5_000;
    const normal = normalGenerator(20260803);
    simulationStats = resetSimulationStats();
    drawOne.disabled = true;
    runSimulations.disabled = true;
    runSimulations.textContent = "Bezig…";
    for (let start = 0; start < total; start += batchSize) {
      let lastStrengths: number[] = [];
      let lastOrder: Array<{ value: number; index: number }> = [];
      const end = Math.min(total, start + batchSize);
      for (let index = start; index < end; index += 1) {
        lastStrengths = possibleStrengths(normal);
        lastOrder = addSimulation(lastStrengths);
      }
      renderSimulationRanking(lastStrengths, lastOrder);
      renderSimulationMetrics();
      const progress = end / total * 100;
      document.querySelector<HTMLElement>("#simulation-number")!.textContent = `Trekking ${end.toLocaleString("nl-NL")}`;
      document.querySelector<HTMLElement>("#simulation-progress-bar")!.style.width = `${progress}%`;
      document.querySelector<HTMLElement>("#simulation-progress-text")!.textContent = `${end.toLocaleString("nl-NL")} van ${total.toLocaleString("nl-NL")} ranglijsten berekend.`;
      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    }
    drawOne.disabled = false;
    runSimulations.disabled = false;
    runSimulations.textContent = "Bereken opnieuw";
    document.querySelector<HTMLElement>("#simulation-progress-text")!.textContent = "100.000 mogelijke ranglijsten berekend. De cijfers zijn nu stabiel.";
  }

  simulationStats = resetSimulationStats();
  renderSimulationMetrics();
  drawManualSimulation();
  drawOne.addEventListener("click", drawManualSimulation);
  runSimulations.addEventListener("click", () => void calculateAllSimulations());

  const quiz = document.querySelector<HTMLFormElement>("#learn-quiz")!;
  quiz.addEventListener("submit", (event) => {
    event.preventDefault();
    let correct = 0;
    const questions = [...quiz.querySelectorAll<HTMLFieldSetElement>("fieldset")];
    questions.forEach((question) => {
      const chosen = question.querySelector<HTMLInputElement>("input:checked")?.value;
      const isCorrect = chosen === question.dataset.answer;
      question.classList.toggle("correct", isCorrect);
      question.classList.toggle("incorrect", Boolean(chosen) && !isCorrect);
      question.classList.toggle("unanswered", !chosen);
      if (isCorrect) correct += 1;
    });
    const result = document.querySelector<HTMLOutputElement>("#quiz-result")!;
    result.textContent = correct === questions.length ? "3 van 3 — je hebt het door." : `${correct} van 3 goed. Bekijk de uitleg onder de vragen en probeer opnieuw.`;
  });

  const lessonSections = [...document.querySelectorAll<HTMLElement>("[data-lesson-section]")];
  const lessonLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-lesson-link]")];
  const pageScroller = document.querySelector<HTMLElement>(".page")!;
  let progressFrame = 0;
  function updateLessonProgress() {
    progressFrame = 0;
    const marker = pageScroller.getBoundingClientRect().top + 120;
    let index = 0;
    lessonSections.forEach((section, sectionIndex) => {
      if (section.getBoundingClientRect().top <= marker) index = sectionIndex;
    });
    lessonLinks.forEach((link, linkIndex) => link.classList.toggle("active", linkIndex === index));
    document.querySelector<HTMLElement>("#learn-progress-current")!.textContent = String(index + 1);
    document.querySelector<HTMLElement>("#learn-progress-bar")!.style.width = `${(index + 1) / lessonSections.length * 100}%`;
  }
  pageScroller.addEventListener("scroll", () => {
    if (!progressFrame) progressFrame = requestAnimationFrame(updateLessonProgress);
  }, { passive: true });
  updateLessonProgress();
</script>

