---
import AppShell from "../components/AppShell.astro";
import ProgressMarks from "../components/ProgressMarks.astro";
---

<AppShell active="mijn-20" title="Mijn 20">
  <section class="submission-page" aria-labelledby="submission-title">
    <div class="submission-heading">
      <div>
        <p class="eyebrow">Jouw inzending</p>
        <h1 id="submission-title">Twintig nummers<br />die je wilt delen.</h1>
      </div>

      <div class="submission-progress" aria-label="Aantal toegevoegde nummers">
        <p><strong id="submission-count">0</strong><span>van 20</span></p>
        <ProgressMarks total={20} current={0} id="submission-progress-marks" />
        <small id="submission-audio-progress">0 van 20 met audio</small>
      </div>
    </div>

    <form class="add-track-form" id="add-track-form">
      <div class="add-track-label-row">
        <label for="track-search">Nummer toevoegen</label>
        <button class="text-action manual-track-open" id="manual-track-open" type="button" disabled>
          <span class="manual-track-question">Niet gevonden? </span>Handmatig toevoegen
        </button>
      </div>
      <div class="track-search-anchor">
        <div class="track-search-controls">
          <input
            id="track-search"
            name="track"
            type="search"
            autocomplete="off"
            placeholder="Zoek op titel, artiest of album"
            aria-controls="track-search-results"
            aria-expanded="false"
            disabled
            required
          />
          <button class="outlined-action search-submit" type="submit" disabled>
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            <span>Zoeken</span>
          </button>
        </div>

        <section class="track-search-results" id="track-search-results" aria-label="Zoekresultaten" hidden>
          <header>
            <h2>Zoekresultaten</h2>
            <button class="search-close" type="button" data-close-search aria-label="Sluit zoekresultaten">
              <i class="ph ph-x" aria-hidden="true"></i>
            </button>
          </header>
          <div class="track-search-content" id="track-search-content" aria-live="polite"></div>
          <footer>
            <span>Resultaten uit de Nederlandse iTunes Store.</span>
            <span>Previews met dank aan iTunes.</span>
          </footer>
        </section>
      </div>
      <p class="form-message" id="submission-message" role="status" aria-live="polite"></p>
    </form>

    <ol class="submission-list" id="submission-list"></ol>

    <div class="submission-footer">
      <button class="outlined-action save-submission" type="button" id="save-submission" disabled>Inzending definitief maken</button>
      <p id="spots-left">Inzending controleren…</p>
      <button class="text-action submission-load-retry" type="button" id="retry-submission-load" hidden>Opnieuw proberen</button>
    </div>
  </section>

  <dialog class="manual-track-dialog" id="manual-track-dialog" aria-labelledby="manual-track-title">
    <button class="manual-track-close" type="button" data-close-manual aria-label="Sluiten">
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
    <p class="eyebrow">Handmatig toevoegen</p>
    <h2 id="manual-track-title">Staat je nummer niet in iTunes?</h2>
    <p>Vul de gegevens zelf in. Na het toevoegen lees je met het audiobestand automatisch de speelduur in.</p>

    <form class="manual-track-form" id="manual-track-form" novalidate>
      <label class="manual-field manual-field--wide" for="manual-title">
        <span>Titel</span>
        <input id="manual-title" name="title" type="text" autocomplete="off" maxlength="200" required />
      </label>
      <label class="manual-field" for="manual-artist">
        <span>Artiest</span>
        <input id="manual-artist" name="artist" type="text" autocomplete="off" maxlength="200" required />
      </label>
      <label class="manual-field" for="manual-album">
        <span>Album <small>optioneel</small></span>
        <input id="manual-album" name="album" type="text" autocomplete="off" maxlength="300" />
      </label>
      <p class="manual-track-error" id="manual-track-error" role="alert" aria-live="assertive"></p>
      <div class="manual-track-actions">
        <button class="outlined-action manual-track-submit" type="submit">Nummer toevoegen</button>
        <button class="text-action" type="button" data-close-manual>Annuleren</button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import { formatDuration, type Track } from "../data/tracks";
  import { getActiveMember } from "../scripts/member-session";

  type AudioRecord = {
    trackId: string;
    title: string;
    artist: string;
    originalName: string;
    mimeType: string;
    size: number;
    duration?: number;
    uploadedAt: string;
    url: string;
  };

  type FinalSubmission = {
    memberId: string;
    tracks: Track[];
    updatedAt: string;
    finalizedAt: string | null;
  };

  const memberId = getActiveMember();
  const state: { submissionIds: string[]; customTracks: Record<string, Track> } = { submissionIds: [], customTracks: {} };
  const list = document.querySelector<HTMLOListElement>("#submission-list")!;
  const page = document.querySelector<HTMLElement>(".submission-page")!;
  const form = document.querySelector<HTMLFormElement>("#add-track-form")!;
  const input = document.querySelector<HTMLInputElement>("#track-search")!;
  const searchAnchor = document.querySelector<HTMLElement>(".track-search-anchor")!;
  const searchPanel = document.querySelector<HTMLElement>("#track-search-results")!;
  const searchContent = document.querySelector<HTMLElement>("#track-search-content")!;
  const searchSubmit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const manualOpen = document.querySelector<HTMLButtonElement>("#manual-track-open")!;
  const manualDialog = document.querySelector<HTMLDialogElement>("#manual-track-dialog")!;
  const manualForm = document.querySelector<HTMLFormElement>("#manual-track-form")!;
  const manualTitle = document.querySelector<HTMLInputElement>("#manual-title")!;
  const manualArtist = document.querySelector<HTMLInputElement>("#manual-artist")!;
  const manualAlbum = document.querySelector<HTMLInputElement>("#manual-album")!;
  const manualError = document.querySelector<HTMLElement>("#manual-track-error")!;
  const manualSubmit = manualForm.querySelector<HTMLButtonElement>('[type="submit"]')!;
  const count = document.querySelector<HTMLElement>("#submission-count")!;
  const audioProgress = document.querySelector<HTMLElement>("#submission-audio-progress")!;
  const marks = Array.from(document.querySelectorAll<HTMLElement>("#submission-progress-marks .progress-mark"));
  const message = document.querySelector<HTMLElement>("#submission-message")!;
  const spotsLeft = document.querySelector<HTMLElement>("#spots-left")!;
  const saveButton = document.querySelector<HTMLButtonElement>("#save-submission")!;
  const retrySubmissionLoad = document.querySelector<HTMLButtonElement>("#retry-submission-load")!;
  const searchCache = new Map<string, Track[]>();
  const currentSearchTracks = new Map<string, Track>();
  const audioRecords = new Map<string, AudioRecord>();
  const uploadingTracks = new Set<string>();
  const removingTracks = new Set<string>();
  const playbackPositions = new Map<string, number>();
  const previewAudio = new Audio();
  const submissionAudio = new Audio();
  let searchTimer: number | undefined;
  let searchVersion = 0;
  let activePreviewId: string | undefined;
  let activeSubmissionId: string | undefined;
  let previewGeneration = 0;
  let submissionPlaybackGeneration = 0;
  let audioIndexLoaded = false;
  let audioIndexFailed = false;
  let submissionStatusLoaded = false;
  let submissionStatusFailed = false;
  let finalSubmission: FinalSubmission | undefined;
  let addingTrack = false;
  let finalizingSubmission = false;

  function submissionBusy(): boolean {
    return addingTrack || finalizingSubmission || removingTracks.size > 0 || uploadingTracks.size > 0;
  }

  function escapeHtml(value: unknown): string {
    return String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    })[character]!);
  }

  function getTrack(id: string): Track | undefined {
    return state.customTracks[id];
  }

  function isSubmissionLocked(): boolean {
    return !submissionStatusLoaded || Boolean(finalSubmission);
  }

  function isFinalSubmission(value: unknown): value is FinalSubmission {
    if (!value || typeof value !== "object") return false;
    const submission = value as Partial<FinalSubmission>;
    return Boolean(
      submission.memberId === memberId
      && (submission.finalizedAt === null || (typeof submission.finalizedAt === "string" && Number.isFinite(Date.parse(submission.finalizedAt))))
      && typeof submission.updatedAt === "string"
      && Array.isArray(submission.tracks)
      && submission.tracks.length <= 20
      && submission.tracks.every((track) => (
        track
        && typeof track.id === "string"
        && typeof track.title === "string"
        && typeof track.artist === "string"
        && typeof track.cover === "string"
        && typeof track.duration === "number"
      )),
    );
  }

  let draftSaveQueue = Promise.resolve();
  function persistDraft(tracks: Track[]): Promise<void> {
    const request = draftSaveQueue.then(async () => {
      const response = await fetch(`/api/submissions/${memberId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ tracks }),
      });
      const payload = await response.json() as { error?: string };
      if (!response.ok) throw new Error(payload.error ?? "De lijst kon niet worden opgeslagen.");
    });
    draftSaveQueue = request.catch(() => undefined);
    return request;
  }

  async function addTrack(track: Track) {
    if (submissionBusy() || isSubmissionLocked() || state.submissionIds.length >= 20 || isTrackSelected(track)) return false;
    const currentTracks = state.submissionIds.map(getTrack).filter((candidate): candidate is Track => Boolean(candidate));
    addingTrack = true;
    render();
    try {
      await persistDraft([...currentTracks, track]);
      state.customTracks[track.id] = track;
      state.submissionIds.push(track.id);
      setMessage("");
      return true;
    } finally {
      addingTrack = false;
      render();
    }
  }

  function formattedFinalizedAt(value: string): string {
    return new Intl.DateTimeFormat("nl-NL", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
  }

  function isTrackSelected(candidate: Track): boolean {
    const title = candidate.title.trim().toLocaleLowerCase("nl-NL");
    const artist = candidate.artist.trim().toLocaleLowerCase("nl-NL");
    return state.submissionIds.some((id) => {
      const selected = getTrack(id);
      return selected?.title.trim().toLocaleLowerCase("nl-NL") === title
        && selected.artist.trim().toLocaleLowerCase("nl-NL") === artist;
    });
  }

  function isAudioRecord(value: unknown): value is AudioRecord {
    if (!value || typeof value !== "object") return false;
    const record = value as Partial<AudioRecord>;
    return Boolean(
      typeof record.trackId === "string"
      && typeof record.title === "string"
      && typeof record.artist === "string"
      && typeof record.originalName === "string"
      && typeof record.mimeType === "string"
      && typeof record.size === "number"
      && (record.duration === undefined || (typeof record.duration === "number" && Number.isFinite(record.duration) && record.duration > 0))
      && typeof record.uploadedAt === "string"
      && typeof record.url === "string"
      && record.url.startsWith("/api/audio/"),
    );
  }

  function isITunesTrack(value: unknown): value is Track {
    if (!value || typeof value !== "object") return false;
    const track = value as Partial<Track>;
    return Boolean(
      typeof track.id === "string"
      && track.id.startsWith("itunes-")
      && typeof track.title === "string"
      && typeof track.artist === "string"
      && typeof track.duration === "number"
      && Number.isFinite(track.duration)
      && typeof track.cover === "string"
      && track.source === "itunes"
      && typeof track.sourceId === "string",
    );
  }

  function audioControls(track: Track): string {
    const record = audioRecords.get(track.id);
    const uploadDisabled = isSubmissionLocked() || submissionBusy();
    const input = `
      <input
        class="audio-file-input"
        type="file"
        data-audio-file
        accept="audio/*,.m4a,.flac"
        aria-label="Kies een audiobestand voor ${escapeHtml(track.title)}"
        ${uploadDisabled ? "disabled" : ""}
      />`;

    if (!audioIndexLoaded) {
      return `
        <div class="submission-audio submission-audio--checking">
          <span class="audio-inline-status"><span class="search-loader" aria-hidden="true"></span> Audio controleren…</span>
        </div>`;
    }

    if (audioIndexFailed) {
      return `
        <div class="submission-audio submission-audio--error">
          <span class="audio-inline-status"><i class="ph ph-warning-circle" aria-hidden="true"></i> Audiostatus niet beschikbaar</span>
          <button class="text-action audio-retry" type="button" data-retry-audio>Probeer opnieuw</button>
        </div>`;
    }

    if (uploadingTracks.has(track.id)) {
      return `
        <div class="submission-audio submission-audio--uploading">
          <span class="audio-inline-status"><span class="search-loader" aria-hidden="true"></span> ${record ? "Nieuw bestand uploaden…" : "Audio uploaden…"}</span>
        </div>`;
    }

    if (!record) {
      return `
        <div class="submission-audio submission-audio--missing" data-audio-drop>
          <span class="audio-required">
            <i class="ph ph-warning-circle" aria-hidden="true"></i>
            <span><strong>Audio ontbreekt</strong><small>Sleep audio hierheen of kies een bestand.</small></span>
          </span>
          <button class="outlined-action audio-upload-action" type="button" data-upload-audio ${uploadDisabled ? "disabled" : ""}>
            <i class="ph ph-upload-simple" aria-hidden="true"></i><span>Audio toevoegen</span>
          </button>
          ${input}
        </div>`;
    }

    const position = playbackPositions.get(track.id) ?? 0;
    const duration = record.duration ?? track.duration;
    return `
      <div class="submission-audio submission-audio--ready" data-row-player ${finalSubmission || uploadDisabled ? "" : "data-audio-drop"}>
        <span class="audio-ready-label" title="${escapeHtml(record.originalName)}">
          <i class="ph ph-check-circle" aria-hidden="true"></i>
          <span><strong>Audio toegevoegd</strong><small>${escapeHtml(record.originalName)}${finalSubmission ? "" : " · sleep om te vervangen"}</small></span>
        </span>
        <div class="row-audio-player">
          <button class="row-audio-toggle" type="button" data-row-play aria-label="Speel ${escapeHtml(track.title)} af" aria-pressed="false">
            <i class="ph ph-play" aria-hidden="true"></i>
          </button>
          <label class="sr-only" for="audio-seek-${escapeHtml(track.id)}">Positie in ${escapeHtml(track.title)}</label>
          <input
            class="row-audio-seek"
            id="audio-seek-${escapeHtml(track.id)}"
            data-row-seek
            type="range"
            min="0"
            max="${duration}"
            step="0.1"
            value="${position}"
            aria-valuetext="${formatDuration(Math.floor(position))} van ${formatDuration(duration)}"
          />
          <output class="row-audio-time" for="audio-seek-${escapeHtml(track.id)}" data-row-time>${formatDuration(Math.floor(position))} / ${formatDuration(duration)}</output>
        </div>
        ${finalSubmission ? "" : `<button class="text-action audio-replace-action" type="button" data-upload-audio ${uploadDisabled ? "disabled" : ""}>Vervang</button>${input}`}
      </div>`;
  }

  function setMessage(text: string, error = false) {
    message.textContent = text;
    message.classList.toggle("error", error);
  }

  function displayedDuration(track: Track): string {
    const measured = audioRecords.get(track.id)?.duration;
    if (measured) return formatDuration(measured);
    if (track.duration > 0) return formatDuration(track.duration);
    return "—";
  }

  function sizeSearchPanel() {
    if (searchPanel.hidden) return;
    const bottomSpace = window.matchMedia("(max-width: 767px)").matches ? 74 : 16;
    const available = window.innerHeight - searchPanel.getBoundingClientRect().top - bottomSpace;
    searchPanel.style.maxHeight = `${Math.max(120, Math.min(454, available))}px`;
  }

  function setSearchOpen(open: boolean) {
    searchPanel.hidden = !open;
    input.setAttribute("aria-expanded", String(open));
    if (open) sizeSearchPanel();
    else stopPreview();
  }

  function closeManualDialog() {
    if (!manualDialog.open || addingTrack) return;
    manualDialog.close();
  }

  function openManualDialog() {
    if (isSubmissionLocked() || state.submissionIds.length >= 20 || submissionBusy()) return;
    setSearchOpen(false);
    manualError.textContent = "";
    manualDialog.showModal();
    window.requestAnimationFrame(() => manualTitle.focus());
  }

  function manualTrackId(): string {
    return `manual-${memberId}-${crypto.randomUUID()}`;
  }

  function renderSearchStatus(kind: "loading" | "empty" | "error" | "hint", text: string) {
    currentSearchTracks.clear();
    searchContent.innerHTML = `
      <div class="search-status search-status--${kind}" role="${kind === "error" ? "alert" : "status"}">
        ${kind === "loading" ? '<span class="search-loader" aria-hidden="true"></span>' : ""}
        <p>${escapeHtml(text)}</p>
      </div>`;
    setSearchOpen(true);
  }

  async function requestITunes(query: string): Promise<Track[]> {
    const key = query.toLocaleLowerCase("nl-NL");
    const cached = searchCache.get(key);
    if (cached) return cached;

    const params = new URLSearchParams({ q: query });
    const response = await fetch(`/api/itunes/search?${params.toString()}`, { headers: { Accept: "application/json" } });
    const payload = await response.json() as { tracks?: unknown; error?: string };
    if (!response.ok) throw new Error(payload.error ?? "iTunes zoeken mislukt.");
    const results = Array.isArray(payload.tracks) ? payload.tracks.filter(isITunesTrack) : [];
    searchCache.set(key, results);
    return results;
  }

  async function pinITunesTrack(track: Track): Promise<Track> {
    if (!track.sourceId) throw new Error("De iTunes-verwijzing van dit nummer ontbreekt.");
    const response = await fetch("/api/itunes/catalog", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ sourceId: track.sourceId }),
    });
    const payload = await response.json() as { track?: unknown; error?: string };
    if (!response.ok || !isITunesTrack(payload.track)) throw new Error(payload.error ?? "Het nummer kon niet worden opgeslagen.");
    return payload.track;
  }

  function renderSearchResults(results: Track[]) {
    currentSearchTracks.clear();
    results.forEach((track) => currentSearchTracks.set(track.id, track));

    searchContent.innerHTML = results
      .map((track) => {
        const selected = isTrackSelected(track);
        const sourceLink = track.sourceUrl
          ? `<a class="search-source-link" href="${escapeHtml(track.sourceUrl)}" target="_blank" rel="noreferrer">iTunes <i class="ph ph-arrow-square-out" aria-hidden="true"></i></a>`
          : "";
        return `
          <article class="search-result" data-search-track="${escapeHtml(track.id)}">
            <img src="${escapeHtml(track.cover)}" alt="" width="56" height="56" loading="lazy" />
            <div class="search-result-copy">
              <strong>${escapeHtml(track.title)}</strong>
              <span>${escapeHtml(track.artist)}</span>
              <small>${escapeHtml(track.album ?? "Single")} · ${escapeHtml(formatDuration(track.duration))} ${sourceLink}</small>
            </div>
            ${track.previewUrl ? `
              <button class="search-preview" type="button" data-preview-track="${escapeHtml(track.id)}" aria-label="Beluister voorproefje van ${escapeHtml(track.title)}" aria-pressed="false">
                <i class="ph ph-play" aria-hidden="true"></i>
              </button>` : '<span class="search-preview-placeholder" aria-hidden="true"></span>'}
            <button class="outlined-action search-add" type="button" data-add-track="${escapeHtml(track.id)}" ${selected || state.submissionIds.length >= 20 ? "disabled" : ""}>
              ${selected ? "Al gekozen" : state.submissionIds.length >= 20 ? "Lijst vol" : "Voeg toe"}
            </button>
          </article>`;
      })
      .join("");
    setSearchOpen(true);
  }

  async function search(query: string) {
    const normalized = query.trim();
    if (normalized.length < 2) {
      renderSearchStatus("hint", "Typ minstens twee tekens om te zoeken.");
      return;
    }

    const version = ++searchVersion;
    renderSearchStatus("loading", `Zoeken naar “${normalized}”…`);
    try {
      const results = await requestITunes(normalized);
      if (version !== searchVersion || input.value.trim() !== normalized) return;
      if (results.length === 0) {
        renderSearchStatus("empty", `Geen nummers gevonden voor “${normalized}”. Probeer een artiest of een kortere titel.`);
        return;
      }
      renderSearchResults(results);
    } catch {
      if (version !== searchVersion) return;
      renderSearchStatus("error", "Zoeken lukt nu niet. Controleer je internetverbinding en probeer het opnieuw.");
    }
  }

  function scheduleSearch() {
    window.clearTimeout(searchTimer);
    const query = input.value.trim();
    if (query.length < 2) {
      searchVersion += 1;
      if (query.length === 0) setSearchOpen(false);
      else renderSearchStatus("hint", "Typ nog één teken om te zoeken.");
      return;
    }
    searchTimer = window.setTimeout(() => search(query), 450);
  }

  function setPreviewButton(trackId: string, playing: boolean) {
    const button = searchContent.querySelector<HTMLButtonElement>(`[data-preview-track="${CSS.escape(trackId)}"]`);
    if (!button) return;
    const track = currentSearchTracks.get(trackId);
    button.classList.toggle("is-playing", playing);
    button.setAttribute("aria-pressed", String(playing));
    button.setAttribute("aria-label", `${playing ? "Pauzeer" : "Beluister"} voorproefje van ${track?.title ?? "dit nummer"}`);
    button.innerHTML = `<i class="ph ph-${playing ? "pause" : "play"}" aria-hidden="true"></i>`;
  }

  function stopPreview(reset = true) {
    previewGeneration += 1;
    if (activePreviewId) setPreviewButton(activePreviewId, false);
    previewAudio.pause();
    if (reset) previewAudio.removeAttribute("src");
    activePreviewId = undefined;
  }

  async function togglePreview(track: Track) {
    if (!track.previewUrl) return;
    if (activePreviewId === track.id && !previewAudio.paused) {
      stopPreview(false);
      return;
    }

    stopPreview();
    stopSubmissionPlayback();
    const generation = previewGeneration;
    activePreviewId = track.id;
    previewAudio.src = track.previewUrl;
    const expectedSource = previewAudio.src;
    previewAudio.volume = 0.85;
    previewAudio.addEventListener("ended", () => {
      if (generation !== previewGeneration || activePreviewId !== track.id || previewAudio.src !== expectedSource) return;
      stopPreview();
    }, { once: true });
    previewAudio.addEventListener("error", () => {
      if (generation !== previewGeneration || activePreviewId !== track.id || previewAudio.src !== expectedSource) return;
      stopPreview();
      setMessage("De preview van dit nummer kan niet worden afgespeeld.", true);
    }, { once: true });
    try {
      await previewAudio.play();
      if (generation !== previewGeneration || activePreviewId !== track.id || previewAudio.src !== expectedSource) return;
      setPreviewButton(track.id, true);
    } catch {
      if (generation !== previewGeneration || activePreviewId !== track.id) return;
      activePreviewId = undefined;
      setPreviewButton(track.id, false);
      setMessage("De preview van dit nummer kan niet worden afgespeeld.", true);
    }
  }

  function rowFor(trackId: string): HTMLElement | null {
    return list.querySelector<HTMLElement>(`[data-track-id="${CSS.escape(trackId)}"]`);
  }

  function setSubmissionPlaying(trackId: string, playing: boolean) {
    const row = rowFor(trackId);
    if (!row) return;
    row.classList.toggle("is-audio-playing", playing);
    for (const button of row.querySelectorAll<HTMLButtonElement>("[data-cover-play], [data-row-play]")) {
      const track = getTrack(trackId);
      button.setAttribute("aria-pressed", String(playing));
      button.setAttribute("aria-label", `${playing ? "Pauzeer" : "Speel"} ${track?.title ?? "dit nummer"}`);
      const icon = button.querySelector("i");
      icon?.classList.toggle("ph-play", !playing);
      icon?.classList.toggle("ph-pause", playing);
    }
  }

  function updateSubmissionTimeline(trackId: string, position: number, duration?: number) {
    const row = rowFor(trackId);
    const track = getTrack(trackId);
    if (!row || !track) return;
    const total = Number.isFinite(duration) && (duration ?? 0) > 0 ? duration! : track.duration;
    const safePosition = Math.max(0, Math.min(position, total));
    playbackPositions.set(trackId, safePosition);
    const seek = row.querySelector<HTMLInputElement>("[data-row-seek]");
    const output = row.querySelector<HTMLOutputElement>("[data-row-time]");
    if (seek) {
      seek.max = String(total);
      seek.value = String(safePosition);
      seek.style.setProperty("--seek-progress", `${total > 0 ? (safePosition / total) * 100 : 0}%`);
      seek.setAttribute("aria-valuetext", `${formatDuration(Math.floor(safePosition))} van ${formatDuration(Math.floor(total))}`);
    }
    if (output) output.textContent = `${formatDuration(Math.floor(safePosition))} / ${formatDuration(Math.floor(total))}`;
  }

  function stopSubmissionPlayback(reset = false) {
    submissionPlaybackGeneration += 1;
    const trackId = activeSubmissionId;
    if (trackId && !submissionAudio.paused) playbackPositions.set(trackId, submissionAudio.currentTime);
    submissionAudio.pause();
    if (reset) {
      submissionAudio.removeAttribute("src");
      if (trackId) playbackPositions.set(trackId, 0);
    }
    if (trackId) setSubmissionPlaying(trackId, false);
    activeSubmissionId = undefined;
  }

  async function toggleSubmissionPlayback(trackId: string) {
    const track = getTrack(trackId);
    if (!track) return;
    if (activeSubmissionId === trackId) {
      stopSubmissionPlayback();
      return;
    }

    stopPreview();
    stopSubmissionPlayback();
    const generation = submissionPlaybackGeneration;
    activeSubmissionId = trackId;
    const record = audioRecords.get(trackId);
    const source = record?.url ?? track.previewUrl;
    try {
      if (!source) throw new Error("Voeg eerst het audiobestand toe.");

      const position = record ? playbackPositions.get(trackId) ?? 0 : 0;
      submissionAudio.src = source;
      const expectedSource = submissionAudio.src;
      submissionAudio.load();
      submissionAudio.addEventListener("loadedmetadata", () => {
        if (generation !== submissionPlaybackGeneration || activeSubmissionId !== trackId || submissionAudio.src !== expectedSource) return;
        const duration = Number.isFinite(submissionAudio.duration) ? submissionAudio.duration : track.duration;
        if (position > 0 && position < duration) submissionAudio.currentTime = position;
        updateSubmissionTimeline(trackId, submissionAudio.currentTime, duration);
      }, { once: true });
      submissionAudio.addEventListener("ended", () => {
        if (generation !== submissionPlaybackGeneration || activeSubmissionId !== trackId || submissionAudio.src !== expectedSource) return;
        const duration = submissionAudio.duration;
        stopSubmissionPlayback(true);
        updateSubmissionTimeline(trackId, 0, duration);
      }, { once: true });
      submissionAudio.addEventListener("error", () => {
        if (generation !== submissionPlaybackGeneration || activeSubmissionId !== trackId || submissionAudio.src !== expectedSource) return;
        stopSubmissionPlayback();
        setMessage("Dit audiobestand kan niet worden afgespeeld.", true);
      }, { once: true });
      await submissionAudio.play();
      if (generation !== submissionPlaybackGeneration || activeSubmissionId !== trackId || submissionAudio.src !== expectedSource) return;
      setSubmissionPlaying(trackId, true);
    } catch {
      if (generation !== submissionPlaybackGeneration || activeSubmissionId !== trackId) return;
      activeSubmissionId = undefined;
      setSubmissionPlaying(trackId, false);
      setMessage("Dit audiobestand kan niet worden afgespeeld.", true);
    }
  }

  async function loadAudioIndex() {
    audioIndexLoaded = false;
    audioIndexFailed = false;
    render();
    try {
      const response = await fetch("/api/audio", { headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error("Audiostatus laden mislukt");
      const payload = await response.json() as { audio?: Record<string, unknown> };
      audioRecords.clear();
      for (const [trackId, record] of Object.entries(payload.audio ?? {})) {
        if (isAudioRecord(record) && record.trackId === trackId) audioRecords.set(trackId, record);
      }
      audioIndexLoaded = true;
      render();
    } catch {
      audioIndexLoaded = true;
      audioIndexFailed = true;
      render();
    }
  }

  async function loadFinalSubmission() {
    submissionStatusLoaded = false;
    submissionStatusFailed = false;
    render();
    try {
      const response = await fetch(`/api/submissions/${memberId}`, { headers: { Accept: "application/json" } });
      const payload = await response.json() as { submission?: unknown; error?: string };
      if (response.ok && payload.submission == null) {
        submissionStatusLoaded = true;
        setMessage("");
        render();
        return;
      }
      if (!response.ok || !isFinalSubmission(payload.submission)) throw new Error(payload.error ?? "De inzending kon niet worden geladen.");
      const submission = payload.submission;
      finalSubmission = submission.finalizedAt ? submission : undefined;
      state.submissionIds = submission.tracks.map((track) => track.id);
      for (const track of submission.tracks) {
        state.customTracks[track.id] = track;
      }
      submissionStatusLoaded = true;
      setMessage("");
      render();
    } catch (error) {
      submissionStatusFailed = true;
      render();
      setMessage(error instanceof Error ? error.message : "De definitieve status kon niet worden geladen.", true);
    }
  }

  async function finalizeCurrentSubmission() {
    if (isSubmissionLocked() || submissionBusy() || state.submissionIds.length !== 20) return;
    const tracks = state.submissionIds.map(getTrack).filter((track): track is Track => Boolean(track));
    if (tracks.length !== 20) {
      setMessage("Een of meer nummers konden niet worden geladen.", true);
      return;
    }
    const missingAudio = tracks.filter((track) => !audioRecords.has(track.id));
    if (missingAudio.length > 0) {
      setMessage(`Voeg eerst audio toe aan alle nummers. Er ontbreken er nog ${missingAudio.length}.`, true);
      return;
    }
    if (!window.confirm("Hierna staan deze twintig nummers definitief vast. Doorgaan?")) return;

    finalizingSubmission = true;
    render();
    try {
      await draftSaveQueue;
      const response = await fetch(`/api/submissions/${memberId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ tracks }),
      });
      const payload = await response.json() as { submission?: unknown; error?: string };
      if (!response.ok || !isFinalSubmission(payload.submission)) throw new Error(payload.error ?? "De inzending kon niet definitief worden gemaakt.");
      finalSubmission = payload.submission;
      setMessage("");
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "De inzending kon niet definitief worden gemaakt.", true);
    } finally {
      finalizingSubmission = false;
      render();
    }
  }

  async function uploadAudio(track: Track, file: File) {
    if (isSubmissionLocked() || submissionBusy()) return;
    if (!file.type.startsWith("audio/")) {
      setMessage("Kies een geldig audiobestand.", true);
      return;
    }
    if (file.size > 100 * 1024 * 1024) {
      setMessage("Het audiobestand mag maximaal 100 MB zijn.", true);
      return;
    }

    stopSubmissionPlayback();
    uploadingTracks.add(track.id);
    setMessage("");
    render();
    try {
      await draftSaveQueue;
      const form = new FormData();
      form.append("audio", file);
      form.append("memberId", memberId);
      const response = await fetch(`/api/audio/${encodeURIComponent(track.id)}`, { method: "POST", body: form });
      const payload = await response.json() as { audio?: unknown; error?: string };
      if (!response.ok || !isAudioRecord(payload.audio)) throw new Error(payload.error ?? "Uploaden is mislukt.");
      audioRecords.set(track.id, payload.audio);
      if (payload.audio.duration) {
        state.customTracks[track.id] = { ...track, duration: Math.round(payload.audio.duration) };
      }
      playbackPositions.set(track.id, 0);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Uploaden is mislukt.", true);
    } finally {
      uploadingTracks.delete(track.id);
      render();
    }
  }

  async function removeTrack(trackId: string) {
    if (isSubmissionLocked() || submissionBusy()) return;
    removingTracks.add(trackId);
    if (activeSubmissionId === trackId) stopSubmissionPlayback();
    render();
    try {
      const nextTracks = state.submissionIds
        .filter((id) => id !== trackId)
        .map(getTrack)
        .filter((track): track is Track => Boolean(track));
      await persistDraft(nextTracks);
      audioRecords.delete(trackId);
      playbackPositions.delete(trackId);
      state.submissionIds = state.submissionIds.filter((id) => id !== trackId);
      delete state.customTracks[trackId];
      setMessage("");
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Het nummer kon niet worden verwijderd.", true);
    } finally {
      removingTracks.delete(trackId);
      render();
    }
  }

  function render() {
    const submissionTracks = state.submissionIds.map(getTrack).filter((track): track is Track => Boolean(track));
    const selectionLocked = isSubmissionLocked();
    const controlsBusy = submissionBusy();
    list.innerHTML = submissionTracks
      .map((track, index) => {
        const removing = removingTracks.has(track.id);
        const canPlay = audioRecords.has(track.id) || Boolean(track.previewUrl);
        return `
          <li class="submission-row${finalSubmission ? " is-final" : ""}" data-track-id="${escapeHtml(track.id)}">
            <span class="row-index">${index + 1}</span>
            <button class="row-cover-button" type="button" data-cover-play aria-label="Speel ${escapeHtml(track.title)}" aria-pressed="false" ${canPlay ? "" : "disabled"}>
              <img src="${escapeHtml(track.cover)}" alt="" width="72" height="72" draggable="false" />
              <span class="row-cover-icon" aria-hidden="true">
                <svg class="row-cover-play" viewBox="0 0 24 24" focusable="false">
                  <path d="M7 4.5 19 12 7 19.5Z" fill="#fff" stroke="#8f101b" stroke-width="2.4" stroke-linejoin="round" />
                </svg>
                <svg class="row-cover-pause" viewBox="0 0 24 24" focusable="false">
                  <rect x="5.5" y="4.5" width="5" height="15" rx="1" fill="#fff" stroke="#8f101b" stroke-width="2.2" />
                  <rect x="13.5" y="4.5" width="5" height="15" rx="1" fill="#fff" stroke="#8f101b" stroke-width="2.2" />
                </svg>
              </span>
            </button>
            <span class="row-track"><strong>${escapeHtml(track.title)}</strong><span>${escapeHtml(track.artist)}</span></span>
            <span class="row-duration">${displayedDuration(track)}</span>
            ${finalSubmission ? "" : `<button class="text-action remove-track" type="button" data-remove ${selectionLocked || controlsBusy ? "disabled" : ""}>${removing ? "Verwijderen…" : "Verwijder"}</button>`}
            ${audioControls(track)}
          </li>`;
      })
      .join("");

    count.textContent = String(state.submissionIds.length);
    page.classList.toggle("is-final", Boolean(finalSubmission));
    marks.forEach((mark, index) => mark.classList.toggle("complete", index < state.submissionIds.length));
    const remaining = 20 - state.submissionIds.length;
    const audioCount = submissionTracks.filter((track) => audioRecords.has(track.id)).length;
    const missingAudio = submissionTracks.length - audioCount;
    audioProgress.textContent = `${audioCount} van 20 met audio`;
    spotsLeft.textContent = !submissionStatusLoaded
      ? submissionStatusFailed ? "Inzending laden mislukt." : "Inzending controleren…"
      : finalSubmission
        ? `Definitief sinds ${formattedFinalizedAt(finalSubmission.finalizedAt!)}.`
        : remaining === 0
          ? missingAudio > 0
            ? `Nog ${missingAudio} ${missingAudio === 1 ? "audiobestand" : "audiobestanden"} toevoegen.`
            : "Alles compleet. Controleer je lijst en maak hem definitief."
          : `Nog ${remaining} ${remaining === 1 ? "plek" : "plekken"} vrij.`;
    input.disabled = selectionLocked || remaining === 0 || controlsBusy;
    searchSubmit.disabled = selectionLocked || remaining === 0 || controlsBusy;
    manualOpen.disabled = selectionLocked || remaining === 0 || controlsBusy;
    saveButton.disabled = selectionLocked || remaining !== 0 || missingAudio !== 0 || !audioIndexLoaded || audioIndexFailed || controlsBusy;
    saveButton.textContent = finalSubmission ? "Inzending is definitief" : finalizingSubmission ? "Definitief maken…" : "Inzending definitief maken";
    retrySubmissionLoad.hidden = !submissionStatusFailed;
    if (selectionLocked || remaining === 0) {
      setSearchOpen(false);
      if (manualDialog.open && !addingTrack) manualDialog.close();
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (isSubmissionLocked() || submissionBusy() || state.submissionIds.length >= 20) return;
    window.clearTimeout(searchTimer);
    search(input.value);
  });

  input.addEventListener("input", () => {
    setMessage("");
    scheduleSearch();
  });

  input.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown" || searchPanel.hidden) return;
    const firstControl = searchContent.querySelector<HTMLElement>("button:not(:disabled), a[href]");
    if (!firstControl) return;
    event.preventDefault();
    firstControl.focus();
  });

  manualOpen.addEventListener("click", openManualDialog);

  manualDialog.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("[data-close-manual]")) closeManualDialog();
  });

  manualDialog.addEventListener("cancel", (event) => {
    if (!addingTrack) return;
    event.preventDefault();
  });

  manualForm.addEventListener("input", () => {
    manualError.textContent = "";
  });

  manualForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (submissionBusy() || isSubmissionLocked() || state.submissionIds.length >= 20) return;
    const title = manualTitle.value.trim();
    const artist = manualArtist.value.trim();
    const album = manualAlbum.value.trim();
    if (!title) {
      manualError.textContent = "Vul de titel van het nummer in.";
      manualTitle.focus();
      return;
    }
    if (!artist) {
      manualError.textContent = "Vul de artiest in.";
      manualArtist.focus();
      return;
    }
    const track: Track = {
      id: manualTrackId(),
      title,
      artist,
      ...(album ? { album } : {}),
      owner: memberId,
      duration: 0,
      cover: "/covers/handmatig.svg",
      source: "manual",
    };
    if (isTrackSelected(track)) {
      manualError.textContent = "Dit nummer staat al in jouw lijst.";
      manualTitle.focus();
      return;
    }

    manualSubmit.disabled = true;
    manualSubmit.textContent = "Toevoegen…";
    try {
      if (!await addTrack(track)) return;
      manualForm.reset();
      manualDialog.close();
    } catch (error) {
      manualError.textContent = error instanceof Error ? error.message : "Het nummer kon niet worden toegevoegd.";
    } finally {
      manualSubmit.disabled = false;
      manualSubmit.textContent = "Nummer toevoegen";
    }
  });

  searchPanel.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("[data-close-search]")) {
      setSearchOpen(false);
      input.focus();
      return;
    }

    const previewButton = target.closest<HTMLButtonElement>("[data-preview-track]");
    if (previewButton) {
      const track = currentSearchTracks.get(previewButton.dataset.previewTrack!);
      if (track) togglePreview(track);
      return;
    }

    const addButton = target.closest<HTMLButtonElement>("[data-add-track]");
    if (!addButton || addButton.disabled || submissionBusy() || isSubmissionLocked() || state.submissionIds.length >= 20) return;
    const track = currentSearchTracks.get(addButton.dataset.addTrack!);
    if (!track || isTrackSelected(track)) return;
    addButton.disabled = true;
    addButton.textContent = "Opslaan…";
    try {
      const storedTrack = await pinITunesTrack(track);
      if (!await addTrack({ ...storedTrack, owner: memberId })) return;
      input.value = "";
      setSearchOpen(false);
    } catch (error) {
      addButton.disabled = false;
      addButton.textContent = "Voeg toe";
      setMessage(error instanceof Error ? error.message : "Het nummer kon niet worden opgeslagen.", true);
    }
  });

  document.addEventListener("click", (event) => {
    if (searchPanel.hidden || searchAnchor.contains(event.target as Node)) return;
    setSearchOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || searchPanel.hidden) return;
    setSearchOpen(false);
    input.focus();
  });

  window.addEventListener("resize", sizeSearchPanel);

  submissionAudio.addEventListener("timeupdate", () => {
    if (!activeSubmissionId || !audioRecords.has(activeSubmissionId)) return;
    updateSubmissionTimeline(activeSubmissionId, submissionAudio.currentTime, submissionAudio.duration);
  });

  list.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const row = target.closest<HTMLElement>("[data-track-id]");
    if (!row) return;
    const id = row.dataset.trackId!;

    if (target.closest("[data-retry-audio]")) {
      loadAudioIndex();
      return;
    }

    if (target.closest("[data-upload-audio]")) {
      row.querySelector<HTMLInputElement>("[data-audio-file]")?.click();
      return;
    }

    if (target.closest("[data-cover-play], [data-row-play]")) {
      toggleSubmissionPlayback(id);
      return;
    }

    if (target.closest("[data-remove]")) {
      removeTrack(id);
      return;
    }
  });

  list.addEventListener("change", (event) => {
    const inputTarget = (event.target as HTMLElement).closest<HTMLInputElement>("[data-audio-file]");
    const trackId = inputTarget?.closest<HTMLElement>("[data-track-id]")?.dataset.trackId;
    const track = trackId ? getTrack(trackId) : undefined;
    const file = inputTarget?.files?.[0];
    if (track && file) uploadAudio(track, file);
  });

  list.addEventListener("input", (event) => {
    const seek = (event.target as HTMLElement).closest<HTMLInputElement>("[data-row-seek]");
    const trackId = seek?.closest<HTMLElement>("[data-track-id]")?.dataset.trackId;
    if (!seek || !trackId) return;
    const position = Number(seek.value);
    playbackPositions.set(trackId, position);
    if (activeSubmissionId === trackId && Number.isFinite(position)) submissionAudio.currentTime = position;
    const duration = Number(seek.max);
    updateSubmissionTimeline(trackId, position, duration);
  });

  list.addEventListener("dragenter", (event) => {
    const dropzone = (event.target as HTMLElement).closest<HTMLElement>("[data-audio-drop]");
    if (!dropzone || !(event as DragEvent).dataTransfer?.types.includes("Files")) return;
    event.preventDefault();
    dropzone.classList.add("is-drag-over");
  });

  list.addEventListener("dragleave", (event) => {
    const dropzone = (event.target as HTMLElement).closest<HTMLElement>("[data-audio-drop]");
    if (!dropzone || dropzone.contains((event as DragEvent).relatedTarget as Node | null)) return;
    dropzone.classList.remove("is-drag-over");
  });

  list.addEventListener("drop", (event) => {
    const dragEvent = event as DragEvent;
    const dropzone = (event.target as HTMLElement).closest<HTMLElement>("[data-audio-drop]");
    if (!dropzone || !dragEvent.dataTransfer?.files.length) return;
    event.preventDefault();
    dropzone.classList.remove("is-drag-over");
    const trackId = dropzone.closest<HTMLElement>("[data-track-id]")?.dataset.trackId;
    const track = trackId ? getTrack(trackId) : undefined;
    if (!track) return;
    if (dragEvent.dataTransfer.files.length > 1) {
      setMessage("Sleep één audiobestand tegelijk naar een nummer.", true);
      return;
    }
    uploadAudio(track, dragEvent.dataTransfer.files[0]);
  });

  saveButton.addEventListener("click", finalizeCurrentSubmission);
  retrySubmissionLoad.addEventListener("click", loadFinalSubmission);

  render();
  loadFinalSubmission();
  loadAudioIndex();
</script>
