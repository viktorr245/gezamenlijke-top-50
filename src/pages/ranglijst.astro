---
import AppShell from "../components/AppShell.astro";
import { members } from "../data/tracks";
---

<AppShell active="ranglijst" title="Ranglijst">
  <section class="ranking-page" aria-labelledby="ranking-title">
    <div class="ranking-heading">
      <div>
        <p class="eyebrow">Ranglijst</p>
        <h1 id="ranking-title">Zo ligt de ranglijst erbij.</h1>
        <p class="heading-copy" id="ranking-copy">De uitslag verschijnt zodra iedereen klaar is.</p>
      </div>
      <div class="group-status" aria-label="Voortgang van de groep">
        <p><strong id="ready-count">0</strong><span>van 5 klaar</span></p>
        <div aria-hidden="true" id="ready-squares">
          {members.map((member) => <span class="status-square" data-status-member={member.id} style={`--status-color:${member.color}`}></span>)}
        </div>
      </div>
    </div>

    <div class="ranking-gate" id="ranking-gate" role="status">
      <span class="search-loader" aria-hidden="true"></span>
      <h2>Ranglijst laden…</h2>
    </div>

    <div id="ranking-content" hidden>
      <div class="ranking-toolbar">
        <div>
          <h2>Alle 100 nummers</h2>
          <p>Speel vanaf iedere plek of klik op de regel voor de exacte berekening.</p>
        </div>
        <div class="ranking-toolbar-actions">
          <button class="ranking-play-action ranking-play-action--primary" type="button" data-play-queue="top50">
            <i class="ph ph-play" aria-hidden="true"></i>
            Speel top 50
          </button>
          <button class="ranking-play-action" type="button" data-play-queue="all">
            Alle 100
          </button>
          <button class="ranking-guide-open" id="ranking-guide-open" type="button">
            <i class="ph ph-question" aria-hidden="true"></i>
            Uitleg bij alle cijfers
          </button>
        </div>
      </div>
      <div class="ranking-columns">
        <span>#</span><span>Nummer</span><span>Ingebracht door</span>
        <button type="button" data-guide-topic="guide-strength">Sterkte <i class="ph ph-question" aria-hidden="true"></i></button>
        <button type="button" data-guide-topic="guide-top50">Kans top 50 <i class="ph ph-question" aria-hidden="true"></i></button>
      </div>
      <ol class="ranking-list" id="ranking-list"></ol>
    </div>
  </section>

  <dialog class="ranking-detail-dialog ranking-guide-dialog" id="ranking-guide-dialog" aria-labelledby="ranking-guide-title">
    <button class="ranking-dialog-close ranking-guide-close" type="button" aria-label="Sluiten">
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
    <div id="ranking-guide-content">
      <header class="ranking-guide-header">
        <p class="eyebrow">Leeswijzer</p>
        <h2 id="ranking-guide-title">Zo lees je deze ranglijst.</h2>
        <p>Elk zichtbaar cijfer komt uit dezelfde 600 keuzes. Hieronder zie je wat ieder getal betekent en hoe de website het precies berekent.</p>
        <a class="text-action ranking-guide-course" href="/uitleg">Leer het hele model interactief</a>
      </header>

      <section class="ranking-guide-example" aria-labelledby="ranking-guide-example-title">
        <div class="ranking-guide-section-heading">
          <div>
            <p class="eyebrow">Een echte regel</p>
            <h3 id="ranking-guide-example-title">Voorbeeld uit de huidige ranglijst</h3>
          </div>
          <span>De waarden hieronder worden rechtstreeks uit nummer 1 overgenomen.</span>
        </div>
        <div id="ranking-guide-example"></div>
      </section>

      <section class="ranking-guide-section" aria-labelledby="ranking-guide-terms-title">
        <div class="ranking-guide-section-heading">
          <div>
            <p class="eyebrow">Wat betekent wat?</p>
            <h3 id="ranking-guide-terms-title">Ieder cijfer in één oogopslag</h3>
          </div>
        </div>
        <div class="ranking-guide-terms">
          <article id="guide-position"><span>01</span><div><h4>Plek</h4><p>De definitieve positie in deze lijst. De website sorteert eerst op de <em>exacte</em> kans op top 50, daarna op verwachte plek en daarna op sterkte.</p></div></article>
          <article id="guide-strength"><span>+1,00</span><div><h4>Sterkte</h4><p>De Bradley–Terry-modelscore. <strong>0,00</strong> is gemiddeld. Alleen het verschil tussen twee nummers telt: één punt verschil betekent ongeveer 73% geschatte voorkeur voor het sterkere nummer.</p></div></article>
          <article id="guide-top50"><span>73%</span><div><h4>Kans top 50</h4><p>Hoe vaak dit nummer in de top 50 stond in 100.000 berekende mogelijke ranglijsten. De regel toont een afgerond heel percentage; voor de sortering gebruikt de website alle decimalen.</p></div></article>
          <article id="guide-expected"><span>24,7</span><div><h4>Verwacht</h4><p>De gemiddelde plek over alle 100.000 mogelijke ranglijsten. Daarom kan dit een kommagetal zijn en afwijken van de definitieve plek links.</p></div></article>
          <article id="guide-interval"><span>12–41</span><div><h4>90%: plek</h4><p>Het middelste gebied waarin 90% van de berekende posities viel. Vijf procent lag hoger en vijf procent lager. Een smalle band betekent meer zekerheid.</p></div></article>
          <article id="guide-owner"><span><i class="member-dot" style="--member-color:#8f101b"></i></span><div><h4>Ingebracht door</h4><p>Laat alleen zien van wie het nummer komt. Er zijn geen persoonlijke quota of bonuspunten en niemand stemt op eigen nummers.</p></div></article>
          <article id="guide-cutoff"><span>50│51</span><div><h4>De streep</h4><p>De vaste selectiegrens. De nummers op plek 1 tot en met 50 gaan mee naar de cd’s; plek 51 en lager niet.</p></div></article>
          <article id="guide-ready"><span>5/5</span><div><h4>Van 5 klaar</h4><p>Groepsvoortgang, geen score. De ranglijst verschijnt pas wanneer alle vijf deelnemers hun 120 keuzes definitief hebben gemaakt.</p></div></article>
          <article id="guide-stability"><span>5×</span><div><h4>Stabiliteitscontrole</h4><p>In de tooltip wordt het model vijf extra keer berekend, telkens zonder de keuzes van één deelnemer. “Stabiele keuze” betekent dat het nummer in alle vijf controles in de top 50 bleef. Dit is alleen controle-informatie en bepaalt de volgorde niet.</p></div></article>
        </div>
      </section>

      <section class="ranking-guide-section" aria-labelledby="ranking-guide-flow-title">
        <div class="ranking-guide-section-heading">
          <div>
            <p class="eyebrow">Van keuze naar uitslag</p>
            <h3 id="ranking-guide-flow-title">Zo ontstaat precies één ranglijstregel</h3>
          </div>
        </div>
        <ol class="ranking-guide-flow">
          <li><span>1</span><div><h4>Twaalf directe vergelijkingen</h4><p>Vier andere deelnemers krijgen het nummer ieder drie keer te zien. Zo heeft ieder nummer twaalf unieke duels. Alle 600 keuzes wegen even zwaar.</p></div></li>
          <li><span>2</span><div><h4>Alle sterktes tegelijk schatten</h4><p>Het model zoekt honderd sterktes die alle gemaakte keuzes samen zo waarschijnlijk mogelijk maken. Een keuze tegen een sterk nummer zegt daardoor meer dan alleen “één winst”.</p><div class="ranking-guide-formula"><span>P(A gekozen)</span><strong>1 / (1 + e<sup>sterkte B − sterkte A</sup>)</strong></div></div></li>
          <li><span>3</span><div><h4>Onzekerheid 100.000 keer doorrekenen</h4><p>Rond de geschatte sterktes zit onzekerheid. De website trekt daarom 100.000 samenhangende sets van mogelijke sterktes en maakt van iedere set een volledige ranglijst van 1 tot 100.</p></div></li>
          <li><span>4</span><div><h4>Tellen, middelen en sorteren</h4><p>Top-50-voorkomens worden geteld, alle posities worden gemiddeld en de 5%- en 95%-grenzen worden opgezocht. Daarna bepaalt de exacte top-50-kans de volgorde.</p></div></li>
        </ol>
      </section>

      <section class="ranking-guide-section ranking-guide-history-note" aria-labelledby="ranking-guide-history-title">
        <i class="ph ph-cursor-click" aria-hidden="true"></i>
        <div>
          <p class="eyebrow">Waarom dit specifieke nummer?</p>
          <h3 id="ranking-guide-history-title">Klik op een ranglijstregel.</h3>
          <p>Daar zie je alle twaalf ruwe keuzes, de vier stemmers, het aantal gewonnen duels en de berekening met de echte waarden van dat nummer.</p>
        </div>
      </section>

      <details class="ranking-guide-technical">
        <summary>De exacte technische rekenregels</summary>
        <div>
          <p>De sterktes minimaliseren de negatieve log-waarschijnlijkheid van alle keuzes plus <strong>0,125 × de som van alle gekwadrateerde sterktes</strong>. Die zwakke regularisatie trekt extreme uitkomsten voorzichtig naar nul en voorkomt een oneindige score bij bijvoorbeeld twaalf uit twaalf keer gekozen.</p>
          <p>De optimalisatie gebruikt maximaal dertig Newton-stappen en stopt eerder zodra de grootste stap kleiner is dan 10<sup>−8</sup>. De inverse kromming rond het optimum levert via een Laplace-benadering de gezamenlijke onzekerheid; Cholesky-ontbinding wordt gebruikt om daaruit 100.000 sets te trekken.</p>
          <p>De trekking is deterministisch gezaaid met de vergelijkings-id’s en winnaars. Dezelfde honderd nummers en dezelfde 600 keuzes geven dus altijd exact dezelfde uitslag. Bij volledig gelijke top-50-kans volgen verwachte plek, sterkte en ten slotte een vaste technische id als sorteersleutels.</p>
        </div>
      </details>
    </div>
  </dialog>

  <dialog class="ranking-detail-dialog ranking-history-dialog" id="ranking-history-dialog" aria-labelledby="ranking-history-title">
    <button class="ranking-dialog-close ranking-history-close" type="button" aria-label="Sluiten">
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
    <div id="ranking-history-content" aria-live="polite">
      <div class="ranking-history-loading">
        <span class="search-loader" aria-hidden="true"></span>
        <h2 id="ranking-history-title">Keuzes laden…</h2>
      </div>
    </div>
  </dialog>

  <section class="ranking-player" id="ranking-player" aria-label="Ranglijstspeler" hidden>
    <div class="ranking-player-drawer" id="ranking-player-drawer" hidden>
      <header class="ranking-player-drawer-heading">
        <div>
          <p class="eyebrow">Nu en wachtrij</p>
          <h2>De ranglijst als afspeellijst.</h2>
        </div>
        <button type="button" data-player-collapse aria-label="Speler inklappen">
          <i class="ph ph-caret-down" aria-hidden="true"></i>
        </button>
      </header>
      <div class="ranking-player-drawer-grid">
        <div class="ranking-player-feature">
          <img data-player-cover-large src="" alt="" width="260" height="260" />
          <p data-player-queue-label>Top 50</p>
          <h3 data-player-title-large></h3>
          <span data-player-artist-large></span>
          <small>De afspeelpositie wordt op dit apparaat onthouden.</small>
        </div>
        <div class="ranking-player-queue-wrap">
          <div>
            <h3>Wachtrij</h3>
            <span data-player-queue-count></span>
          </div>
          <ol class="ranking-player-queue" id="ranking-player-queue"></ol>
        </div>
      </div>
    </div>

    <div class="ranking-player-timeline">
      <input type="range" min="0" max="0" step="0.1" value="0" data-player-seek aria-label="Positie in het nummer" />
    </div>
    <div class="ranking-player-bar">
      <button class="ranking-player-current" type="button" data-player-expand aria-expanded="false" aria-controls="ranking-player-drawer">
        <img data-player-cover src="" alt="" width="62" height="62" />
        <span>
          <small data-player-position></small>
          <strong data-player-title></strong>
          <span data-player-artist></span>
        </span>
      </button>

      <div class="ranking-player-controls" aria-label="Afspeelbediening">
        <button type="button" data-player-previous aria-label="Vorig nummer"><i class="ph ph-skip-back" aria-hidden="true"></i></button>
        <button type="button" data-player-back aria-label="10 seconden terug"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i><small>10</small></button>
        <button class="ranking-player-toggle" type="button" data-player-toggle aria-label="Afspelen" aria-pressed="false"><i class="ph ph-play" aria-hidden="true"></i></button>
        <button type="button" data-player-forward aria-label="10 seconden vooruit"><i class="ph ph-arrow-clockwise" aria-hidden="true"></i><small>10</small></button>
        <button type="button" data-player-next aria-label="Volgend nummer"><i class="ph ph-skip-forward" aria-hidden="true"></i></button>
      </div>

      <div class="ranking-player-time">
        <span><output data-player-elapsed>0:00</output><i>/</i><output data-player-duration>0:00</output></span>
        <small data-player-status>Klaar om af te spelen</small>
      </div>
      <button class="ranking-player-expand" type="button" data-player-expand aria-expanded="false" aria-controls="ranking-player-drawer" aria-label="Wachtrij openen">
        <i class="ph ph-caret-up" aria-hidden="true"></i>
      </button>
      <button class="ranking-player-close" type="button" data-player-close aria-label="Speler sluiten">
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </div>
    <audio id="ranking-audio" preload="auto" playsinline></audio>
    <p class="sr-only" data-player-announcement aria-live="polite"></p>
  </section>
</AppShell>

<script>
  import { getMember, type Track } from "../data/tracks";
  import { createRankingPlayer } from "../scripts/ranking-player";

  type RankedTrack = Track & {
    rank: number;
    selected: boolean;
    strength: number;
    top50Probability: number;
    expectedRank: number;
    rankLow: number;
    rankHigh: number;
    winRate: number;
    leaveOneOutSelections: number;
  };

  type RankingPayload = {
    status: {
      phase: string;
      votingComplete: boolean;
      completedVoterCount: number;
      finalizedCount: number;
      members: Array<{ memberId: string; votingDone: boolean; voteCount: number }>;
    };
    ranking: RankedTrack[] | null;
  };

  type TrackHistoryPayload = {
    history: {
      track: Track;
      comparisonCount: number;
      selectedThisTrackCount: number;
      selectedOtherTrackCount: number;
      voters: Array<{
        voterId: string;
        selectedThisTrackCount: number;
        comparisons: Array<{
          id: string;
          opponent: Track;
          selectedThisTrack: boolean;
          chosenAt: string;
        }>;
      }>;
    };
  };

  const gate = document.querySelector<HTMLElement>("#ranking-gate")!;
  const content = document.querySelector<HTMLElement>("#ranking-content")!;
  const list = document.querySelector<HTMLOListElement>("#ranking-list")!;
  const copy = document.querySelector<HTMLElement>("#ranking-copy")!;
  const count = document.querySelector<HTMLElement>("#ready-count")!;
  const guideDialog = document.querySelector<HTMLDialogElement>("#ranking-guide-dialog")!;
  const guideContent = document.querySelector<HTMLElement>("#ranking-guide-content")!;
  const guideExample = document.querySelector<HTMLElement>("#ranking-guide-example")!;
  const historyDialog = document.querySelector<HTMLDialogElement>("#ranking-history-dialog")!;
  const historyContent = document.querySelector<HTMLElement>("#ranking-history-content")!;
  const rankingPlayer = createRankingPlayer();
  const rankingById = new Map<string, RankedTrack>();
  const historyCache = new Map<string, TrackHistoryPayload["history"]>();
  let activeHistoryTrackId: string | undefined;
  const rankingSamples = 100_000;

  function openGuide(topicId?: string) {
    if (!guideDialog.open) guideDialog.showModal();
    if (!topicId) {
      guideContent.scrollTop = 0;
      return;
    }
    requestAnimationFrame(() => {
      const topic = document.getElementById(topicId);
      if (!topic) return;
      guideContent.scrollTop += topic.getBoundingClientRect().top - guideContent.getBoundingClientRect().top - 20;
      topic.classList.add("is-highlighted");
      window.setTimeout(() => topic.classList.remove("is-highlighted"), 1100);
    });
  }

  document.querySelector<HTMLButtonElement>("#ranking-guide-open")?.addEventListener("click", () => openGuide());
  document.querySelector<HTMLButtonElement>(".ranking-guide-close")?.addEventListener("click", () => guideDialog.close());
  document.querySelectorAll<HTMLButtonElement>("[data-guide-topic]").forEach((button) => {
    button.addEventListener("click", () => openGuide(button.dataset.guideTopic));
  });
  guideDialog.addEventListener("click", (event) => {
    if (event.target === guideDialog) guideDialog.close();
  });

  document.querySelector<HTMLButtonElement>(".ranking-history-close")?.addEventListener("click", () => historyDialog.close());
  historyDialog.addEventListener("click", (event) => {
    if (event.target === historyDialog) historyDialog.close();
  });
  historyDialog.addEventListener("close", () => {
    activeHistoryTrackId = undefined;
  });

  function escapeHtml(value: unknown): string {
    return String(value).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[character]!);
  }

  function formatStrength(value: number): string {
    const roundedValue = Math.abs(value) < 0.005 ? 0 : value;
    return roundedValue.toLocaleString("nl-NL", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
      signDisplay: "exceptZero",
    });
  }

  function formatDetailedStrength(value: number): string {
    const roundedValue = Math.abs(value) < 0.00005 ? 0 : value;
    return roundedValue.toLocaleString("nl-NL", {
      minimumFractionDigits: 4,
      maximumFractionDigits: 4,
      signDisplay: "exceptZero",
    });
  }

  function guideExampleMarkup(track: RankedTrack) {
    const member = getMember(track.owner);
    const expectedRank = track.expectedRank.toLocaleString("nl-NL", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const exactChance = (track.top50Probability * 100).toLocaleString("nl-NL", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
    return `
      <div class="ranking-guide-example-track">
        <img src="${escapeHtml(track.cover)}" alt="" width="74" height="74" />
        <div><strong>${escapeHtml(track.title)}</strong><span>${escapeHtml(track.artist)}</span><small><i class="member-dot" style="--member-color:${member.color}"></i> Ingebracht door ${escapeHtml(member.name)}</small></div>
      </div>
      <dl class="ranking-guide-example-values">
        <div><dt>Plek</dt><dd>${String(track.rank).padStart(2, "0")}</dd><small>Definitieve volgorde</small></div>
        <div><dt>Sterkte</dt><dd>${formatStrength(track.strength)}</dd><small>Exact ${formatDetailedStrength(track.strength)}</small></div>
        <div><dt>Kans top 50</dt><dd>${Math.round(track.top50Probability * 100)}%</dd><small>Exact ${exactChance}%</small></div>
        <div><dt>Verwacht</dt><dd>${expectedRank}</dd><small>Gemiddelde plek</small></div>
        <div><dt>90%: plek</dt><dd>${track.rankLow}–${track.rankHigh}</dd><small>Middelste 90%</small></div>
      </dl>`;
  }

  function rowMarkup(track: RankedTrack) {
    const member = getMember(track.owner);
    const stability = track.leaveOneOutSelections === 5 ? "Stabiele keuze" : `${track.leaveOneOutSelections} van 5 controles in de top 50`;
    const expectedRank = track.expectedRank.toLocaleString("nl-NL", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const strength = formatStrength(track.strength);
    return `
      <li class="ranking-row ${track.selected ? "" : "outside"}" data-rank="${track.rank}" data-ranking-track-id="${escapeHtml(track.id)}">
        <button class="ranking-row-button" type="button" data-history-track-id="${escapeHtml(track.id)}" aria-label="Bekijk de keuzes voor ${escapeHtml(track.title)}" title="Verwachte plek ${track.expectedRank.toFixed(1)} · 90%-interval ${track.rankLow}–${track.rankHigh} · ${stability} · Klik voor alle keuzes">
          <span class="rank-number">${String(track.rank).padStart(2, "0")}</span>
          <span class="rank-cover"><img src="${escapeHtml(track.cover)}" alt="" width="64" height="64" /></span>
          <span class="rank-track">
            <span class="rank-track-main"><strong>${escapeHtml(track.title)}</strong><span>${escapeHtml(track.artist)}</span></span>
            <small class="rank-uncertainty"><span class="rank-strength-mobile">Sterkte ${strength} · </span>Verwacht ${expectedRank} · 90%: plek ${track.rankLow}–${track.rankHigh}</small>
          </span>
          <span class="rank-owner"><i class="member-dot" style="--member-color:${member.color}"></i>${member.name}</span>
          <span class="rank-strength" title="Modelsterkte ${strength}; 0,00 is gemiddeld">${strength}</span>
          <strong class="rank-score"><span>${Math.round(track.top50Probability * 100)}%</span><i class="ph ph-caret-right" aria-hidden="true"></i></strong>
        </button>
        <button class="ranking-row-play" type="button" data-play-track-id="${escapeHtml(track.id)}" aria-label="Speel ${escapeHtml(track.title)} vanaf plek ${track.rank}" title="Speel vanaf plek ${track.rank}">
          <i class="ph ph-play" aria-hidden="true"></i>
        </button>
      </li>
      ${track.rank === 50 ? '<li class="cutoff-marker"><span>De streep</span><small>Deze 50 gaan mee.</small></li>' : ""}`;
  }

  function historyMarkup(history: TrackHistoryPayload["history"], rankedTrack: RankedTrack) {
    const owner = getMember(history.track.owner);
    const selectedPercentage = history.comparisonCount
      ? Math.round(history.selectedThisTrackCount / history.comparisonCount * 100)
      : 0;
    const top50Count = Math.round(rankedTrack.top50Probability * rankingSamples);
    const exactTop50Percentage = (rankedTrack.top50Probability * 100).toLocaleString("nl-NL", { minimumFractionDigits: 3, maximumFractionDigits: 3 });
    const rankPositionTotal = Math.round(rankedTrack.expectedRank * rankingSamples);
    const expectedRank = rankedTrack.expectedRank.toLocaleString("nl-NL", { minimumFractionDigits: 1, maximumFractionDigits: 2 });
    const voterMarkup = history.voters.map((voterHistory) => {
      const voter = getMember(voterHistory.voterId);
      const otherCount = voterHistory.comparisons.length - voterHistory.selectedThisTrackCount;
      const choices = voterHistory.comparisons.map((comparison) => `
        <li class="ranking-history-choice ${comparison.selectedThisTrack ? "picked-current" : "picked-other"}">
          <span class="ranking-history-outcome">
            <i class="ph ${comparison.selectedThisTrack ? "ph-check" : "ph-arrow-right"}" aria-hidden="true"></i>
            <span><strong>${comparison.selectedThisTrack ? "Dit nummer" : "De ander"}</strong><small>gekozen</small></span>
          </span>
          <span class="ranking-history-opponent">
            <img src="${escapeHtml(comparison.opponent.cover)}" alt="" width="52" height="52" />
            <span><small>Tegen</small><strong>${escapeHtml(comparison.opponent.title)}</strong><span>${escapeHtml(comparison.opponent.artist)}</span></span>
          </span>
        </li>`).join("");
      return `
        <section class="ranking-history-voter">
          <header>
            <span><i class="member-dot" style="--member-color:${voter.color}"></i><strong>${escapeHtml(voter.name)}</strong></span>
            <small>${voterHistory.selectedThisTrackCount}× dit nummer · ${otherCount}× de ander</small>
          </header>
          <ul>${choices}</ul>
        </section>`;
    }).join("");

    return `
      <div class="ranking-history-hero">
        <img src="${escapeHtml(history.track.cover)}" alt="" width="104" height="104" />
        <div>
          <p class="eyebrow">Keuzegeschiedenis · plek ${rankedTrack.rank}</p>
          <h2 id="ranking-history-title">${escapeHtml(history.track.title)}</h2>
          <p>${escapeHtml(history.track.artist)}</p>
          <small>Ingebracht door ${escapeHtml(owner.name)}</small>
        </div>
      </div>
      <div class="ranking-history-summary">
        <p><strong>${history.selectedThisTrackCount}</strong><span>van ${history.comparisonCount} keer gekozen</span></p>
        <p><strong>${selectedPercentage}%</strong><span>duels gewonnen</span></p>
        <p><strong>${formatStrength(rankedTrack.strength)}</strong><span>modelsterkte</span></p>
        <p><strong>${Math.round(rankedTrack.top50Probability * 100)}%</strong><span>kans op top 50</span></p>
      </div>
      <p class="ranking-history-context">Omdat ${escapeHtml(owner.name)} dit nummer inzond, stemden de andere vier deelnemers er ieder drie keer over. De eindplek gebruikt niet alleen het aantal keuzes, maar ook de geschatte sterkte van de tegenstanders en de onzekerheid in het Bradley–Terry-model.</p>
      <section class="ranking-history-calculation">
        <div class="ranking-history-calculation-heading">
          <div><p class="eyebrow">De exacte berekening</p><h3>Waarom plek ${rankedTrack.rank}?</h3></div>
          <button type="button" data-guide-topic="guide-position">Leg alle termen uit <i class="ph ph-arrow-up-right" aria-hidden="true"></i></button>
        </div>
        <ol>
          <li><span>1</span><div><strong>Alle 600 keuzes gezamenlijk geschat</strong><small>de 12 directe duels én de verbindingen via alle tegenstanders</small></div><b>= sterkte ${formatDetailedStrength(rankedTrack.strength)}</b></li>
          <li><span>2</span><div><strong>${top50Count.toLocaleString("nl-NL")} van 100.000</strong><small>mogelijke ranglijsten in de top 50</small></div><b>= ${exactTop50Percentage}% kans</b></li>
          <li><span>3</span><div><strong>${rankPositionTotal.toLocaleString("nl-NL")} posities ÷ 100.000</strong><small>alle berekende posities bij elkaar</small></div><b>= verwacht ${expectedRank}</b></li>
          <li><span>4</span><div><strong>90% viel op plek ${rankedTrack.rankLow}–${rankedTrack.rankHigh}</strong><small>de 5% hoogste en 5% laagste uitkomsten vallen erbuiten</small></div><b>onzekerheidsband</b></li>
        </ol>
        <p>Alle honderd nummers worden gesorteerd op hun niet-afgeronde top-50-kans. Bij exact gelijke kans volgt de verwachte plek, daarna de modelsterkte. Met die volledige waarden eindigt dit nummer op <strong>plek ${rankedTrack.rank}</strong>. De zichtbare hele procenten kunnen dus gelijk lijken terwijl de onderliggende kansen nog verschillen.</p>
      </section>
      <div class="ranking-history-section-heading">
        <h3>Alle vergelijkingen</h3>
        <span>${history.comparisonCount} keuzes door ${history.voters.length} deelnemers</span>
      </div>
      <div class="ranking-history-voters">${voterMarkup}</div>`;
  }

  async function openHistory(trackId: string) {
    const rankedTrack = rankingById.get(trackId);
    if (!rankedTrack) return;
    activeHistoryTrackId = trackId;
    historyContent.innerHTML = `
      <div class="ranking-history-loading">
        <span class="search-loader" aria-hidden="true"></span>
        <h2 id="ranking-history-title">Keuzes laden…</h2>
        <p>${escapeHtml(rankedTrack.title)}</p>
      </div>`;
    if (!historyDialog.open) historyDialog.showModal();

    const cached = historyCache.get(trackId);
    if (cached) {
      historyContent.innerHTML = historyMarkup(cached, rankedTrack);
      return;
    }

    try {
      const response = await fetch(`/api/ranking/${encodeURIComponent(trackId)}`, { headers: { Accept: "application/json" } });
      const payload = await response.json() as TrackHistoryPayload & { error?: string };
      if (!response.ok || !payload.history) throw new Error(payload.error ?? "De keuzes konden niet worden geladen.");
      historyCache.set(trackId, payload.history);
      if (!historyDialog.open || activeHistoryTrackId !== trackId) return;
      historyContent.innerHTML = historyMarkup(payload.history, rankedTrack);
    } catch (error) {
      if (!historyDialog.open || activeHistoryTrackId !== trackId) return;
      historyContent.innerHTML = `
        <div class="ranking-history-error">
          <p class="eyebrow">Niet beschikbaar</p>
          <h2 id="ranking-history-title">De keuzes konden niet worden geladen.</h2>
          <p>${escapeHtml(error instanceof Error ? error.message : "Probeer het later opnieuw.")}</p>
          <button class="outlined-action" type="button" data-retry-history="${escapeHtml(trackId)}">Opnieuw proberen</button>
        </div>`;
    }
  }

  list.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-history-track-id]");
    if (button?.dataset.historyTrackId) void openHistory(button.dataset.historyTrackId);
  });

  historyContent.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-retry-history]");
    if (button?.dataset.retryHistory) void openHistory(button.dataset.retryHistory);
  });

  historyContent.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-guide-topic]");
    if (!button?.dataset.guideTopic) return;
    historyDialog.close();
    openGuide(button.dataset.guideTopic);
  });

  function render(payload: RankingPayload) {
    count.textContent = String(payload.status.completedVoterCount);
    for (const status of payload.status.members) {
      document.querySelector<HTMLElement>(`[data-status-member="${CSS.escape(status.memberId)}"]`)?.classList.toggle("complete", status.votingDone);
    }
    if (!payload.status.votingComplete || !payload.ranking) {
      content.hidden = true;
      gate.hidden = false;
      copy.textContent = payload.status.finalizedCount < 5
        ? "Eerst levert iedereen twintig nummers met audio in."
        : "De uitslag blijft verborgen totdat iedereen zijn 120 keuzes heeft gemaakt.";
      gate.innerHTML = `
        <p class="eyebrow">Nog even geduld</p>
        <h2>${payload.status.completedVoterCount} van 5 deelnemers zijn klaar.</h2>
        <p>Iedereen kan zelfstandig verdergaan. De definitieve top 50 verschijnt automatisch na de laatste keuze.</p>
        <a class="text-action ranking-gate-course" href="/uitleg">Bekijk hoe de uitslag wordt berekend</a>`;
      return;
    }
    gate.hidden = true;
    content.hidden = false;
    copy.textContent = "Berekend uit alle 600 keuzes; de kans houdt ook rekening met onzekerheid rond de grens.";
    rankingById.clear();
    payload.ranking.forEach((track) => rankingById.set(track.id, track));
    rankingPlayer.setRanking(payload.ranking);
    guideExample.innerHTML = guideExampleMarkup(payload.ranking[0]);
    list.innerHTML = payload.ranking.map(rowMarkup).join("");
  }

  fetch("/api/ranking", { headers: { Accept: "application/json" } })
    .then(async (response) => {
      const payload = await response.json() as RankingPayload & { error?: string };
      if (!response.ok) throw new Error(payload.error ?? "Ranglijst laden mislukt.");
      render(payload);
    })
    .catch((error) => {
      gate.innerHTML = `<p class="eyebrow">Niet beschikbaar</p><h2>De ranglijst kan niet worden geladen.</h2><p>${escapeHtml(error instanceof Error ? error.message : "Probeer het later opnieuw.")}</p>`;
    });
</script>
